{"name":"aic — AI-powered git commits","short_name":"aic","description":"aic reads your diff, drafts a conventional commit, and commits it — one command. Nothing staged? It groups your work into logical commits for you.","start_url":"/aic/","scope":"/aic/","display":"standalone","background_color":"#0e0f14","theme_color":"#0e0f14","icons":[{"src":"/aic/icons/icon-192.png","sizes":"192x192","type":"image/png","purpose":"any"},{"src":"/aic/icons/icon-512.png","sizes":"512x512","type":"image/png","purpose":"any"},{"src":"/aic/icons/maskable-192.png","sizes":"192x192","type":"image/png","purpose":"maskable"},{"src":"/aic/icons/maskable-512.png","sizes":"512x512","type":"image/png","purpose":"maskable"}]}