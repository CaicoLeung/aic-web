---
/**
 * ScrollDemo — V2 scroll-driven product demo.
 *
 * ONE terminal, content builds up line-by-line as the user scrolls.
 * Nothing disappears — output accumulates like a real session.
 *
 * The terminal is position: sticky — it pins and stays fixed while
 * the 300vh outer section provides scroll room. A git-graph on the
 * left grows nodes in sync.
 *
 * No-JS / reduced-motion: all lines visible (final state).
 * V2-only: mounted only on /v2 routes.
 */
---

<section class="scroll-demo" data-scroll-demo>
  <div class="demo-pin">
    <div class="demo-inner container">
      <!-- Left: persistent git-graph track -->
      <div class="demo-graph" aria-hidden="true">
        <div class="graph-origin" title="main"></div>
        <div class="graph-seg" data-seg="1">
          <span class="seg-line"></span>
          <span class="seg-node" data-node="1">
            <span class="node-label">feat</span>
          </span>
        </div>
        <div class="graph-seg" data-seg="2">
          <span class="seg-line"></span>
          <span class="seg-node" data-node="2">
            <span class="node-label">fix</span>
          </span>
        </div>
        <div class="graph-seg" data-seg="3">
          <span class="seg-line"></span>
          <span class="seg-node" data-node="3">
            <span class="node-label">chore</span>
          </span>
        </div>
      </div>

      <!-- Right: single terminal with progressive lines -->
      <div class="demo-terminal">
        <div class="term-chrome">
          <div class="term-dots">
            <i></i><i></i><i></i>
          </div>
          <span class="term-title">aic</span>
        </div>

        <div class="term-scroll" data-term-scroll>
          <pre
            class="term-body"><span class="line r0"><span class="prompt">$</span> <span class="cmd">aic</span></span>
<span class="line r0 muted">Scanning 12 changed files…</span>
<span class="line r0 cyan">3 logical commits detected</span>
<span class="line r0 muted sep">━━ reviewing plan ━━</span>
<span class="line r1 label">commit 1</span><span class="line r1 amber">  feat(auth): refresh token rotation</span>
<span class="line r1 muted sub">  auth/refresh.ts, auth/verify.ts</span>
<span class="line r1 label">commit 2</span><span class="line r1 amber">  fix(ui): redirect on session expiry</span>
<span class="line r1 muted sub">  components/Redirect.tsx</span>
<span class="line r1 label">commit 3</span><span class="line r1 amber">  chore: bump dependencies</span>
<span class="line r1 muted sub">  package.json, lock.json</span>
<span class="line r2 mint">✓ 3 commits created</span>
<span class="line r2 cyan dim">12 files → 3 commits in 4.2s</span></pre>
        </div>
      </div>
    </div>

    <!-- Scroll hint -->
    <div class="demo-hint" aria-hidden="true">
      <span class="hint-text">scroll</span>
      <span class="hint-arrow">↓</span>
    </div>
  </div>
</section>

<style>
  .scroll-demo {
    position: relative;
    height: 300vh;
    background: var(--color-base-deep);
  }

  .demo-pin {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .demo-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
    width: 100%;
  }

  /* ── Git graph track ─────────────────────────────────────────────── */
  .demo-graph {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 0;
    min-height: 280px;
  }

  .graph-origin {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--color-ink-dim);
    background: var(--color-base);
    flex-shrink: 0;
  }

  .graph-seg {
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }
  .graph-seg.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .seg-line {
    width: 2px;
    height: 48px;
    background: linear-gradient(
      to bottom,
      color-mix(in oklch, var(--color-amber) 50%, transparent),
      var(--color-amber)
    );
  }

  .seg-node {
    position: relative;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-amber);
    box-shadow: 0 0 16px -2px color-mix(in oklch, var(--color-amber) 60%, transparent);
    flex-shrink: 0;
  }

  .node-label {
    position: absolute;
    left: 28px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-ink-muted);
    white-space: nowrap;
    letter-spacing: 0.05em;
  }

  /* ── Terminal ────────────────────────────────────────────────────── */
  .demo-terminal {
    border: 1px solid var(--color-line);
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-surface);
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.03),
      0 20px 60px -20px rgba(0, 0, 0, 0.5);
  }

  .term-chrome {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--color-line);
    background: rgba(0, 0, 0, 0.2);
  }

  .term-dots {
    display: flex;
    gap: 6px;
  }
  .term-dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: block;
  }
  .term-dots i:nth-child(1) {
    background: #ff5f57;
  }
  .term-dots i:nth-child(2) {
    background: #febc2e;
  }
  .term-dots i:nth-child(3) {
    background: #28c840;
  }

  .term-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-ink-dim);
    margin-left: 0.5rem;
  }

  /* Scrollable terminal body — auto-scrolls to show latest content */
  .term-scroll {
    max-height: clamp(280px, 50vh, 380px);
    overflow-y: auto;
    scrollbar-width: none;
  }
  .term-scroll::-webkit-scrollbar {
    display: none;
  }

  .term-body {
    margin: 0;
    padding: 1.25rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.65;
    white-space: pre-wrap;
    color: var(--color-ink);
  }

  /* Progressive line reveal — default hidden, JS reveals by stage */
  .line {
    display: inline;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }
  .line.is-shown {
    opacity: 1;
    transform: translateY(0);
  }
  /* No-JS fallback: everything visible */
  .term-body .line {
    opacity: 1;
    transform: none;
  }
  /* JS takes over */
  .scroll-demo[data-js] .line {
    opacity: 0;
    transform: translateY(4px);
  }
  .scroll-demo[data-js] .line.is-shown {
    opacity: 1;
    transform: translateY(0);
  }

  .prompt {
    color: var(--color-cyan);
    font-weight: 600;
  }
  .cmd {
    color: var(--color-ink);
    font-weight: 600;
  }
  .muted {
    color: var(--color-ink-dim);
  }
  .sub {
    font-size: 0.78rem;
    opacity: 0.8;
  }
  .cyan {
    color: var(--color-cyan);
  }
  .amber {
    color: var(--color-amber);
  }
  .mint {
    color: var(--color-mint);
    font-weight: 600;
  }
  .dim {
    opacity: 0.7;
  }
  .sep {
    letter-spacing: 0.1em;
  }
  .label {
    color: var(--color-cyan);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* ── Scroll hint ─────────────────────────────────────────────────── */
  .demo-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }
  .demo-hint.is-hidden {
    opacity: 0;
  }
  .hint-text {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-dim);
  }
  .hint-arrow {
    color: var(--color-ink-dim);
    font-size: 1rem;
    animation: hint-bounce 1.5s ease-in-out infinite;
  }
  @keyframes hint-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  /* ── Mobile ──────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .demo-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .demo-graph {
      flex-direction: row;
      min-height: auto;
      justify-content: center;
    }
    .graph-seg {
      flex-direction: row;
    }
    .seg-line {
      width: 32px;
      height: 2px;
    }
    .node-label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hint-arrow {
      animation: none;
    }
    .line {
      transform: none !important;
      transition: opacity 0.15s ease;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-scroll-demo]');
  if (!section) {
    // V1 page
  } else {
    const lines = section.querySelectorAll<HTMLElement>('.line');
    const segs = section.querySelectorAll<HTMLElement>('.graph-seg');
    const hint = section.querySelector<HTMLElement>('.demo-hint');
    const termScroll = section.querySelector<HTMLElement>('[data-term-scroll]');

    // Stages: r0 (0-33%), r1 (33-66%), r2 (66-100%)
    const STAGE_OF: Record<string, number> = { r0: 0, r1: 1, r2: 2 };

    section.setAttribute('data-js', '');

    let ticking = false;

    function update() {
      ticking = false;
      const rect = section.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const progress = Math.max(0, Math.min(1, -rect.top / scrollable));

      // Current stage: 0, 1, or 2
      const stage = Math.min(2, Math.floor(progress * 3));

      // Reveal lines whose stage <= current
      lines.forEach((line) => {
        const cls = Array.from(line.classList).find((c) => c in STAGE_OF);
        if (cls !== undefined) {
          const lineStage = STAGE_OF[cls];
          line.classList.toggle('is-shown', lineStage <= stage);
        }
      });

      // Graph nodes: grow with stages, all on final
      const visibleCount = stage === 2 ? segs.length : stage;
      segs.forEach((s, i) => s.classList.toggle('is-visible', i < visibleCount));

      // Auto-scroll terminal to bottom so latest content is visible
      if (termScroll) {
        termScroll.scrollTop = termScroll.scrollHeight;
      }

      // Hide scroll hint
      if (hint) hint.classList.toggle('is-hidden', progress > 0.05);
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
