---
/**
 * ScrollDemo — V2 scroll-driven product demo.
 *
 * ONE terminal, content builds up as the user scrolls. Three phases:
 *   r0: Agent startup ($ aic → init → ready)
 *   r1: Agent thinking (analyze files → group → propose plan)
 *   r2: Ship (commit --all → results → summary)
 *
 * Terminal is position: sticky — pins and stays fixed during scroll.
 * Git-graph on the left grows commit nodes in sync.
 *
 * No-JS / reduced-motion: all lines visible (final state).
 * V2-only.
 */
---

<section class="scroll-demo" data-scroll-demo>
  <div class="demo-pin">
    <div class="demo-inner container">
      <!-- Left: persistent git-graph track -->
      <div class="demo-graph" aria-hidden="true">
        <div class="graph-seg" data-seg="1">
          <span class="seg-node" data-node="1">
            <span class="node-label">feat</span>
          </span>
          <span class="seg-line"></span>
        </div>
        <div class="graph-seg" data-seg="2">
          <span class="seg-node" data-node="2">
            <span class="node-label">fix</span>
          </span>
          <span class="seg-line"></span>
        </div>
        <div class="graph-seg" data-seg="3">
          <span class="seg-node" data-node="3">
            <span class="node-label">chore</span>
          </span>
          <span class="seg-line"></span>
        </div>
      </div>

      <!-- Right: single terminal with progressive lines -->
      <div class="demo-terminal">
        <div class="term-chrome">
          <div class="term-dots"><i></i><i></i><i></i></div>
          <span class="term-title">aic</span>
        </div>

        <div class="term-scroll" data-term-scroll>
          <div class="term-body">
            <!-- r0: Agent startup -->
            <div class="tline r0">
              <span class="prompt">$</span>
              <span class="cmd">aic</span>
            </div>
            <div class="tline r0 blank"></div>
            <div class="tline r0 accent">⟢ agent starting</div>
            <div class="tline r0 muted">config <span class="val">.aic.yml</span></div>
            <div class="tline r0 muted">
              model <span class="val">gpt-4o-mini</span> · fast
            </div>
            <div class="tline r0 muted">ready <span class="mint">✓ 0.8s</span></div>

            <!-- r1: Agent thinking + plan -->
            <div class="tline r1 blank"></div>
            <div class="tline r1 accent">⟢ analyzing 12 changed files</div>
            <div class="tline r1 muted">
              auth/refresh.ts <span class="bracket">┐</span> token rotation
            </div>
            <div class="tline r1 muted">
              auth/verify.ts <span class="bracket">┘</span>
            </div>
            <div class="tline r1 muted">Redirect.tsx session expiry fix</div>
            <div class="tline r1 muted">
              package.json <span class="bracket">┐</span> dependency bump
            </div>
            <div class="tline r1 muted">lock.json <span class="bracket">┘</span></div>
            <div class="tline r1 cyan">3 commit groups identified</div>
            <div class="tline r1 blank"></div>
            <div class="tline r1 muted sep">━━ proposed plan ━━</div>
            <div class="tline r1">
              <span class="num"> 1</span>
              <span class="amber">feat(auth): refresh token rotation</span>
            </div>
            <div class="tline r1">
              <span class="num"> 2</span>
              <span class="amber">fix(ui): redirect on session expiry</span>
            </div>
            <div class="tline r1">
              <span class="num"> 3</span>
              <span class="amber">chore: bump dependencies</span>
            </div>

            <!-- r2: Ship -->
            <div class="tline r2 blank"></div>
            <div class="tline r2">
              <span class="prompt">→</span>
              <span class="cmd">aic commit --all</span>
            </div>
            <div class="tline r2 blank"></div>
            <div class="tline r2 mint">✓ abc1234 chore: bump dependencies</div>
            <div class="tline r2 mint">✓ def5678 fix(ui): redirect on expiry</div>
            <div class="tline r2 mint">✓ ghi9012 feat(auth): refresh token rotation</div>
            <div class="tline r2 blank"></div>
            <div class="tline r2 cyan">12 files → 3 commits in 4.2s</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll hint -->
    <div class="demo-hint" aria-hidden="true">
      <span class="hint-text">scroll</span>
      <span class="hint-arrow">↓</span>
    </div>
  </div>
</section>

<style>
  .scroll-demo {
    position: relative;
    height: 300vh;
    background: var(--color-base-deep);
  }

  .demo-pin {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .demo-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
    width: 100%;
  }

  /* ── Git graph track ─────────────────────────────────────────────── */
  .demo-graph {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    min-height: 280px;
  }

  .graph-seg {
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    transform: translateY(-0.5rem);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }
  .graph-seg.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .seg-node {
    position: relative;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-amber);
    box-shadow: 0 0 16px -2px color-mix(in oklch, var(--color-amber) 60%, transparent);
    flex-shrink: 0;
  }

  .seg-line {
    width: 2px;
    height: 48px;
    background: linear-gradient(
      to bottom,
      var(--color-amber),
      color-mix(in oklch, var(--color-amber) 50%, transparent)
    );
  }

  .node-label {
    position: absolute;
    left: 28px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-ink-muted);
    white-space: nowrap;
    letter-spacing: 0.05em;
  }

  /* ── Terminal ────────────────────────────────────────────────────── */
  .demo-terminal {
    border: 1px solid var(--color-line);
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-surface);
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.03),
      0 20px 60px -20px rgba(0, 0, 0, 0.5);
  }

  .term-chrome {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--color-line);
    background: rgba(0, 0, 0, 0.2);
  }

  .term-dots {
    display: flex;
    gap: 6px;
  }
  .term-dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: block;
  }
  .term-dots i:nth-child(1) {
    background: #ff5f57;
  }
  .term-dots i:nth-child(2) {
    background: #febc2e;
  }
  .term-dots i:nth-child(3) {
    background: #28c840;
  }

  .term-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-ink-dim);
    margin-left: 0.5rem;
  }

  .term-scroll {
    max-height: clamp(380px, 68vh, 540px);
    overflow-y: auto;
    scrollbar-width: none;
  }
  .term-scroll::-webkit-scrollbar {
    display: none;
  }

  .term-body {
    padding: 1.25rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--color-ink);
  }

  /* Each terminal line is a block — no fragile newline management.
   * No-JS fallback: visible by default. JS hides them, then reveals
   * progressively via .is-shown. */
  .tline {
    white-space: pre;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }
  .scroll-demo:not([data-js]) .tline {
    opacity: 1;
    transform: none;
  }
  .scroll-demo[data-js] .tline {
    opacity: 0;
    transform: translateY(4px);
  }
  .scroll-demo[data-js] .tline.is-shown {
    opacity: 1;
    transform: translateY(0);
  }

  .tline.blank {
    min-height: 0.4em;
  }

  .prompt {
    color: var(--color-cyan);
    font-weight: 600;
  }
  .cmd {
    color: var(--color-ink);
    font-weight: 600;
  }
  .muted {
    color: var(--color-ink-dim);
  }
  .cyan {
    color: var(--color-cyan);
  }
  .amber {
    color: var(--color-amber);
  }
  .mint {
    color: var(--color-mint);
    font-weight: 600;
  }
  .accent {
    color: var(--color-cyan);
    font-weight: 600;
  }
  .sep {
    letter-spacing: 0.1em;
  }
  .val {
    color: var(--color-ink-muted);
  }
  .bracket {
    color: var(--color-ink-dim);
  }
  .num {
    color: var(--color-cyan);
    font-weight: 600;
  }

  /* ── Scroll hint ─────────────────────────────────────────────────── */
  .demo-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }
  .demo-hint.is-hidden {
    opacity: 0;
  }
  .hint-text {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-dim);
  }
  .hint-arrow {
    color: var(--color-ink-dim);
    font-size: 1rem;
    animation: hint-bounce 1.5s ease-in-out infinite;
  }
  @keyframes hint-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  /* ── Mobile ──────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .demo-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .demo-graph {
      flex-direction: row;
      min-height: auto;
      justify-content: center;
    }
    .graph-seg {
      flex-direction: row;
    }
    .seg-line {
      width: 32px;
      height: 2px;
    }
    .node-label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hint-arrow {
      animation: none;
    }
    .tline {
      transform: none !important;
      transition: opacity 0.15s ease;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-scroll-demo]');
  if (!section) {
    // V1 page
  } else {
    const lines = section.querySelectorAll<HTMLElement>('.tline');
    const segs = section.querySelectorAll<HTMLElement>('.graph-seg');
    const hint = section.querySelector<HTMLElement>('.demo-hint');
    const termScroll = section.querySelector<HTMLElement>('[data-term-scroll]');

    const STAGE_OF: Record<string, number> = { r0: 0, r1: 1, r2: 2 };

    section.setAttribute('data-js', '');

    let ticking = false;

    function update() {
      ticking = false;
      const rect = section.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const progress = Math.max(0, Math.min(1, -rect.top / scrollable));

      const stage = Math.min(2, Math.floor(progress * 3));

      lines.forEach((line) => {
        const cls = Array.from(line.classList).find((c) => c in STAGE_OF);
        if (cls !== undefined) {
          const lineStage = STAGE_OF[cls];
          line.classList.toggle('is-shown', lineStage <= stage);
        }
      });

      const visibleCount = stage === 2 ? segs.length : stage;
      segs.forEach((s, i) => s.classList.toggle('is-visible', i < visibleCount));

      if (termScroll) {
        termScroll.scrollTop = termScroll.scrollHeight;
      }

      if (hint) hint.classList.toggle('is-hidden', progress > 0.05);
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
