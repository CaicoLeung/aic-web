---
/**
 * /alternatives/{id} — singular migration-intent page (ADR-0006).
 *
 * Format 1 of the competitors playbook: validates why people look for an
 * alternative, positions aic as the alternative, reuses the vs-page
 * comparison matrix, and gives an honest switch/stay call plus migration
 * steps. Comparison facts come from `src/config/competitors.ts`; prose is
 * hand-maintained per competitor (editorial, ADR-0006).
 *
 * Rendered by both `/alternatives/{id}/` and `/[locale]/alternatives/{id}/`
 * (ADR-0010). The Article shell self-determines locale; stubbed keys fall
 * back to EN.
 */
import CopyButton from '@/components/ui/CopyButton.astro';
import ArticleShell from '@/components/content/ArticleShell.astro';
import type { CompetitorComparison } from '@/config/competitors';
import { GITHUB_URL, PRIMARY_INSTALL_COMMAND } from '@/config/site';
import { localizedHref, localeFromUrl } from '@/i18n/config';
import { assertRivalMessages } from '@/i18n/assert';
import { useLocalizer, useMessages } from '@/i18n/t';
import FeatureMatrix from '@/components/content/FeatureMatrix.astro';

/** Message-block keys under `meta.alt` / `alt` (competitor pages, not hub). */
interface Props {
  /**
   * Editorial comparison data (`src/config/competitors.ts`). The rival id is
   * the single source of truth for the message-block key (alt + vs axes),
   * the breadcrumb, and the cross-links — no separate `id` prop.
   */
  comparison: CompetitorComparison;
}

const { comparison } = Astro.props;
// Derive every id-keyed lookup from the data, not a parallel prop.
const id = comparison.rival.id;
const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
const m = useMessages(locale);
// Build-time gate: a missing i18n block fails the build clearly (ADR-0007 gap:
// `.astro` frontmatter isn't type-checked, and `m.alt[id]` is a string index).
assertRivalMessages(m, id);
const alt = m.alt[id];
const vsAxes = m.vs[id].axes;
const { rival, axes } = comparison;
const title = t(`meta.alt.${id}.title`);
const description = t(`meta.alt.${id}.description`);
const vsPage = localizedHref(locale, `vs/${id}`);
---

<ArticleShell
  title={title}
  description={description}
  datePublished="2026-08-01"
  about={['aic', rival.name, 'AI commit message tools']}
  crumbs={[
    { name: t('contentHeader.home'), path: '' },
    { name: t('alt.hub.eyebrow'), path: 'alternatives' },
    { name: alt.h1, path: '' },
  ]}
>
  <p class="eyebrow"><span class="line" aria-hidden="true"></span>{alt.eyebrow}</p>
  <h1>{alt.h1}</h1>
  <p class="lede" set:html={alt.lede} />

  <!-- Why switch -->
  <section class="block">
    <h2>{alt.whyH}</h2>
    <p>{alt.why}</p>
  </section>

  <!-- Comparison matrix (reuses vs-page axes) -->
  <FeatureMatrix
    axes={axes}
    axisLabels={vsAxes}
    rivalName={rival.name}
    labels={m.vs.matrix}
  />

  <p class="inline-cta">
    <a href="#cta">{m.vs.more.installCta}</a>
  </p>

  <!-- Switch / stay -->
  <section class="switch-grid block">
    <div class="switch-col">
      <h2>{alt.switchH}</h2>
      <p>{alt.shouldSwitch}</p>
    </div>
    <div class="switch-col stay">
      <h2>{alt.notH}</h2>
      <p>{alt.shouldNot}</p>
    </div>
  </section>

  <!-- Migration -->
  <section class="block">
    <h2>{alt.migrateH}</h2>
    <ol class="migrate">
      {
        /*
        Install step sources the command from PRIMARY_INSTALL_COMMAND (ADR-0003)
        rather than re-typing it in every locale's prose (ADR-0006). Only the
        localized lead-in lives in the message module; the command is
        code-register, rendered as <code> by the component.
      */
      }
      <li>{t('alt.migrateLead')} <code>{PRIMARY_INSTALL_COMMAND}</code></li>
      {alt.migrate.map((step) => <li set:html={step} />)}
    </ol>
  </section>

  <!-- CTA + full comparison -->
  <section class="verdict" id="cta">
    <div class="cta">
      <CopyButton text={PRIMARY_INSTALL_COMMAND} variant="primary" />
      <a class="cta-link" href={vsPage}>{m.vs[id].h1}</a>
      <a class="cta-link" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
        {t('footer.star')}
      </a>
    </div>
  </section>
</ArticleShell>

<style>
  /* Page-unique styles. The article CSS layer (.article namespace) lives in
     ArticleShell. */
  .block p {
    color: var(--color-ink-muted);
    line-height: 1.65;
  }

  /* Switch / stay */
  .switch-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  @media (max-width: 640px) {
    .switch-grid {
      grid-template-columns: 1fr;
    }
  }
  .switch-col {
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-line-soft);
    border-radius: 12px;
    background: var(--color-surface);
  }
  .switch-col.stay {
    border-color: var(--color-line);
  }
  .switch-col h2 {
    font-size: 1.05rem;
    margin: 0 0 0.5rem;
  }

  /* Migration */
  .migrate {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
    font-size: 0.95rem;
  }
</style>
