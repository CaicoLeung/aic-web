---
/**
 * /deepseek/ — capability page (ADR-0006): aic + DeepSeek provider guide.
 *
 * Owns the "DeepSeek commit message" narrative (tool-finder intent, esp.
 * Chinese developers where DeepSeek is the default choice). Hand-maintained
 * prose; facts (default model, env vars) match the aic source repo.
 *
 * Rendered by both `/deepseek/` and `/[locale]/deepseek/` (ADR-0010).
 */
import { loadAicFacts } from '@/data/aic';
import Base from '@/layouts/Base.astro';
import ContentHeader from '@/components/content/ContentHeader.astro';
import Footer from '@/components/footer/Footer.astro';
import CopyButton from '@/components/ui/CopyButton.astro';
import { GITHUB_URL, PRIMARY_INSTALL_COMMAND } from '@/config/site';
import { localizedHref, localeFromUrl } from '@/i18n/config';
import { useLocalizer, useMessages } from '@/i18n/t';

const facts = await loadAicFacts();
const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
const m = useMessages(locale);
const d = m.deepseek;
const title = t('meta.deepseek.title');
const description = t('meta.deepseek.description');
const roundup = localizedHref(locale, 'best-ai-commit-tools');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: '2026-08-01',
  dateModified: '2026-08-01',
  author: { '@type': 'Organization', name: 'aic' },
  publisher: { '@type': 'Organization', name: 'aic' },
  about: ['aic', 'DeepSeek', 'AI commit message tools'],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Base
  version={facts.version}
  title={title}
  description={description}
  schema={[schema, faqSchema]}
>
  <ContentHeader version={facts.version} />

  <main id="main">
    <article class="article container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={localizedHref(locale, '')}>{t('contentHeader.home')}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{d.h1}</span>
      </nav>
      <p class="eyebrow"><span class="line" aria-hidden="true"></span>{d.eyebrow}</p>
      <h1>{d.h1}</h1>
      <p class="lede" set:html={d.lede} />

      <!-- Why -->
      <section class="block">
        <h2>{d.whyH}</h2>
        <ul class="points">
          {d.why.map((point) => <li set:html={point} />)}
        </ul>
      </section>

      <!-- Setup -->
      <section class="block">
        <h2>{d.setupH}</h2>
        <ol class="steps">
          {d.setup.map((step) => <li set:html={step} />)}
        </ol>
        <p class="env" set:html={d.env} />
      </section>

      <!-- Model -->
      <section class="block">
        <h2>{d.modelH}</h2>
        <p set:html={d.model} />
      </section>

      <!-- FAQ -->
      <section class="block">
        <h2>{d.faqH}</h2>
        <div class="faq">
          {
            d.faq.map((item) => (
              <div class="faq-item">
                <h3>{item.q}</h3>
                <p>{item.a}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="verdict">
        <div class="cta">
          <CopyButton text={PRIMARY_INSTALL_COMMAND} variant="primary" />
          <a class="cta-link" href={roundup}>
            {t('batching.cmpLink')}
          </a>
          <a class="cta-link" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
            {t('footer.star')}
          </a>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</Base>

<style>
  .article {
    max-width: 820px;
    padding-block: clamp(2.5rem, 1rem + 4vw, 4.5rem) clamp(3rem, 1rem + 5vw, 5rem);
    position: relative;
    z-index: 2;
  }
  h1 {
    font-size: var(--text-h2);
    line-height: 1.05;
    margin: 0.75rem 0 0;
  }
  .lede {
    color: var(--color-ink-muted);
    line-height: 1.65;
    margin-top: 1rem;
    font-size: var(--text-lede);
  }
  .lede code {
    color: var(--color-amber);
    font-family: var(--font-mono);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-ink-dim);
    margin-bottom: 0.5rem;
  }
  .crumbs a {
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--color-amber);
  }
  .crumbs span[aria-current='page'] {
    color: var(--color-ink);
  }

  .block {
    margin-top: 2.75rem;
  }
  .block h2 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
  }
  .block p {
    color: var(--color-ink-muted);
    line-height: 1.65;
  }
  .block p code,
  .block li code {
    color: var(--color-amber);
    font-family: var(--font-mono);
  }

  .points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
    font-size: 0.95rem;
  }
  .points li::before {
    content: '✓';
    color: var(--color-mint);
    font-weight: 700;
    margin-right: 0.5rem;
  }

  .steps {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
    font-size: 0.95rem;
  }
  .env {
    font-size: 0.9rem;
  }

  .faq {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .faq-item h3 {
    font-size: 1rem;
    margin: 0 0 0.35rem;
    color: var(--color-ink);
  }
  .faq-item p {
    color: var(--color-ink-muted);
    line-height: 1.6;
    font-size: 0.95rem;
    margin: 0;
  }

  .verdict {
    margin-top: 2.75rem;
    padding: 1.75rem;
    border: 1px solid var(--color-line-soft);
    border-radius: 14px;
    background: var(--color-surface);
  }
  .cta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .cta-link {
    color: var(--color-ink);
    text-decoration: none;
    padding: 0.55rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    transition:
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }
  .cta-link:hover {
    border-color: var(--color-amber);
    color: var(--color-amber);
  }
</style>
