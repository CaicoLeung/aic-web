---
/**
 * /deepseek/ — capability page (ADR-0006): aic + DeepSeek provider guide.
 *
 * Owns the "DeepSeek commit message" narrative (tool-finder intent, esp.
 * Chinese developers where DeepSeek is the default choice). Hand-maintained
 * prose; facts (default model, env vars) match the aic source repo.
 *
 * Rendered by both `/deepseek/` and `/[locale]/deepseek/` (ADR-0010). The
 * Article shell self-determines locale.
 */
import CopyButton from '@/components/ui/CopyButton.astro';
import ArticleShell from '@/components/content/ArticleShell.astro';
import { GITHUB_URL, PRIMARY_INSTALL_COMMAND } from '@/config/site';
import { localizedHref, localeFromUrl } from '@/i18n/config';
import { useLocalizer, useMessages } from '@/i18n/t';

const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
const m = useMessages(locale);
const d = m.deepseek;
const title = t('meta.deepseek.title');
const description = t('meta.deepseek.description');
const roundup = localizedHref(locale, 'best-ai-commit-tools');
---

<ArticleShell
  title={title}
  description={description}
  datePublished="2026-08-01"
  about={['aic', 'DeepSeek', 'AI commit message tools']}
  faq={d.faq.items}
  crumbs={[
    { name: t('contentHeader.home'), path: '' },
    { name: d.h1, path: '' },
  ]}
>
  <p class="eyebrow"><span class="line" aria-hidden="true"></span>{d.eyebrow}</p>
  <h1>{d.h1}</h1>
  <p class="lede" set:html={d.lede} />

  <!-- Why -->
  <section class="block">
    <h2>{d.whyH}</h2>
    <ul class="checks">
      {d.why.map((point) => <li set:html={point} />)}
    </ul>
  </section>

  <!-- Setup -->
  <section class="block">
    <h2>{d.setupH}</h2>
    <ol class="setup-list">
      {d.setup.map((step) => <li set:html={step} />)}
    </ol>
    <p class="env" set:html={d.env} />
  </section>

  <!-- Model -->
  <section class="block">
    <h2>{d.modelH}</h2>
    <p set:html={d.model} />
  </section>

  <!-- FAQ -->
  <section class="block">
    <h2>{d.faq.h2}</h2>
    <div class="faq">
      {
        d.faq.items.map((item) => (
          <div class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="verdict">
    <div class="cta">
      <CopyButton text={PRIMARY_INSTALL_COMMAND} variant="primary" />
      <a class="cta-link" href={roundup}>
        {t('batching.cmpLink')}
      </a>
      <a class="cta-link" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
        {t('footer.star')}
      </a>
    </div>
  </section>
</ArticleShell>

<style>
  /* Page-unique styles. The article CSS layer (.article namespace) lives in
     ArticleShell — `.checks`/`.setup-list` are named to avoid colliding with
     the shell's `.points` (two-column point lists) and `.steps` (numbered
     workflow steps). */
  .block p {
    color: var(--color-ink-muted);
    line-height: 1.65;
  }

  .checks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
    font-size: 0.95rem;
  }
  .checks li::before {
    content: '✓';
    color: var(--color-mint);
    font-weight: 700;
    margin-right: 0.5rem;
  }

  .setup-list {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
    font-size: 0.95rem;
  }
  .env {
    font-size: 0.9rem;
  }
</style>
