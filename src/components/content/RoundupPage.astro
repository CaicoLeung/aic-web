---
/**
 * /best-ai-commit-tools — roundup page (ADR-0006).
 *
 * Fair survey of the field (CONTEXT.md → "Roundup page"): aic is disclosed
 * as the home team and positioned honestly, not declared the winner in a
 * vacuum. Each one-liner is a verified editorial judgment
 * (src/config/competitors.ts → ROUNDUP). Targets the "best AI commit
 * message tools" / comparison cluster.
 *
 * Rendered by both `/best-ai-commit-tools/` and
 * `/[locale]/best-ai-commit-tools/` (ADR-0010). The Article shell
 * self-determines locale; all prose + meta wire `t()`/`useMessages`;
 * stubbed keys fall back to EN (soft parity, Q7=B).
 */
import CopyButton from '@/components/ui/CopyButton.astro';
import ArticleShell from '@/components/content/ArticleShell.astro';
import { ROUNDUP } from '@/config/competitors';
import { GITHUB_URL, HUNK_SPLITTING, PRIMARY_INSTALL_COMMAND } from '@/config/site';
import { localizedHref, localeFromUrl } from '@/i18n/config';
import { useLocalizer, useMessages } from '@/i18n/t';

const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
const m = useMessages(locale);
const vsAicommits = localizedHref(locale, 'vs/aicommits');
const resolve = localizedHref(locale, 'resolve');

const title = t('meta.roundup.title', { year: '2026' });
const description = t('meta.roundup.description');
---

<ArticleShell
  title={title}
  description={description}
  datePublished="2026-07-08"
  about={['AI commit message tools', 'git', 'conventional commits']}
>
  <p class="eyebrow">
    <span class="line" aria-hidden="true"></span>{t('roundup.eyebrow')}
  </p>
  <h1>{t('roundup.h1')}</h1>
  <p class="lede" set:html={t('roundup.lede')} />

  <aside class="callout" set:html={t('roundup.callout')} />

  <!-- How to choose -->
  <section class="block">
    <h2>{t('roundup.choose.h2')}</h2>
    <ul class="chooser">
      {
        m.roundup.choose.items.map((item) => (
          <li>
            <>
              <span class="need">{item.need}</span>
              <span class="pick">{item.pick}</span>
            </>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Cards -->
  <section class="block">
    <h2>{t('roundup.field.h2')}</h2>
    <ul class="cards">
      {
        ROUNDUP.map((tool) => (
          <li class:list={['card', { home: tool.homeTeam }]}>
            <div class="card-head">
              <h3>{tool.name}</h3>
              {tool.homeTeam && <span class="badge">{t('roundup.field.badge')}</span>}
            </div>
            <p class="runtime">{tool.runtime}</p>
            {tool.homeTeam && (
              <div class="hl">
                <span class="hl-eyebrow">
                  {t('roundup.field.hlEyebrow', {
                    version: HUNK_SPLITTING.shippedIn,
                  })}
                </span>
                <p class="hl-head">{t('roundup.field.hlHead')}</p>
                <p class="hl-sub">{t('roundup.field.hlSub')}</p>
              </div>
            )}
            <p class="strength">{m.roundup.tools[tool.id].strength}</p>
            <div class="card-links">
              {tool.homeTeam ? (
                <>
                  <CopyButton
                    text={PRIMARY_INSTALL_COMMAND}
                    label="brew install aic"
                    variant="primary"
                  />
                  <a class="card-link" href={vsAicommits}>
                    {t('roundup.field.vsAicommitsLink')}
                  </a>
                </>
              ) : (
                <>
                  <a
                    class="card-link"
                    href={tool.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {t('roundup.field.repoLink')}
                  </a>
                  {tool.vsPath && (
                    <a class="card-link" href={localizedHref(locale, tool.vsPath)}>
                      {t('roundup.field.compareLink')}
                    </a>
                  )}
                </>
              )}
            </div>
          </li>
        ))
      }
    </ul>
    <p class="field-note" set:html={t('roundup.field.note')} />
  </section>

  <!-- Closing -->
  <section class="verdict">
    <h2>{t('roundup.verdict.h2')}</h2>
    <p set:html={t('roundup.verdict.body')} />
    <div class="cta">
      <CopyButton text={PRIMARY_INSTALL_COMMAND} variant="primary" />
      <a class="cta-link" href={resolve}>{t('footer.nav.resolve')}</a>
      <a class="cta-link" href={vsAicommits}>{t('roundup.verdict.seeVs')}</a>
      <a class="cta-link" href={GITHUB_URL} target="_blank" rel="noopener noreferrer"
        >{t('footer.star')}</a
      >
    </div>
  </section>
</ArticleShell>

<style>
  /* Page-unique styles. The article CSS layer (.article namespace) lives in
     ArticleShell. */

  /* Chooser */
  .chooser {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .chooser li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--color-line-soft);
    border-radius: 10px;
    background: var(--color-surface);
  }
  .need {
    color: var(--color-ink);
  }
  .pick {
    font-family: var(--font-mono);
    color: var(--color-amber);
    font-size: 0.92rem;
  }

  /* Cards */
  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border: 1px solid var(--color-line-soft);
    border-radius: 14px;
    background: var(--color-surface);
  }
  .card.home {
    border-color: var(--color-amber);
    background: color-mix(in oklch, var(--color-surface) 82%, var(--color-amber-soft));
  }
  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .card h3 {
    font-size: 1.2rem;
    margin: 0;
  }
  .badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1a1408;
    background: var(--color-amber);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
    font-weight: 700;
  }
  .runtime {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-ink-dim);
    margin: 0;
  }
  /* Per-hunk highlight — pulled forward so the differentiator is scannable,
     not buried in the strength paragraph. Home card only. */
  .hl {
    margin: 0.6rem 0;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-amber);
    border-radius: 8px;
    background: rgba(243, 179, 64, 0.06);
  }
  .hl-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-amber);
    font-weight: 600;
  }
  .hl-head {
    margin: 0.3rem 0 0.2rem;
    color: var(--color-ink);
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .hl-sub {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .strength {
    color: var(--color-ink-muted);
    line-height: 1.6;
    font-size: 0.94rem;
    margin: 0.25rem 0 0.75rem;
    flex: 1;
  }
  .card-links {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
  }
  .card-link {
    color: var(--color-amber);
    text-decoration: none;
    font-size: 0.85rem;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) ease;
  }
  .card-link:hover {
    border-bottom-color: var(--color-amber);
  }
  .field-note {
    color: var(--color-ink-dim);
    font-size: 0.88rem;
    line-height: 1.6;
    margin-top: 1.25rem;
  }
</style>
