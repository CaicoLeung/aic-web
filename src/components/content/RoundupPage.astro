---
/**
 * /best-ai-commit-tools — roundup page (ADR-0006).
 *
 * Fair survey of the field (CONTEXT.md → "Roundup page"): aic is disclosed
 * as the home team and positioned honestly, not declared the winner in a
 * vacuum. Each one-liner is a verified editorial judgment
 * (src/config/competitors.ts → ROUNDUP). Targets the "best AI commit
 * message tools" / comparison cluster.
 *
 * Rendered by both `/best-ai-commit-tools/` and
 * `/[locale]/best-ai-commit-tools/` (ADR-0010). Base self-determines
 * locale; all prose + meta wire `t()`/`useMessages`; stubbed keys fall
 * back to EN (soft parity, Q7=B).
 */
import { loadAicFacts } from '@/data/aic';
import Base from '@/layouts/Base.astro';
import ContentHeader from '@/components/content/ContentHeader.astro';
import Footer from '@/components/footer/Footer.astro';
import CopyButton from '@/components/ui/CopyButton.astro';
import { ROUNDUP } from '@/config/competitors';
import { GITHUB_URL, HUNK_SPLITTING, PRIMARY_INSTALL_COMMAND } from '@/config/site';
import { localizedHref, localeFromUrl } from '@/i18n/config';
import { useLocalizer, useMessages } from '@/i18n/t';

const facts = await loadAicFacts();
const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
const m = useMessages(locale);
const vsAicommits = localizedHref(locale, 'vs/aicommits');
const resolve = localizedHref(locale, 'resolve');

const title = t('meta.roundup.title', { year: '2026' });
const description = t('meta.roundup.description');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: '2026-07-08',
  dateModified: '2026-07-08',
  author: { '@type': 'Organization', name: 'aic' },
  publisher: { '@type': 'Organization', name: 'aic' },
  about: ['AI commit message tools', 'git', 'conventional commits'],
};
---

<Base version={facts.version} title={title} description={description} schema={schema}>
  <ContentHeader version={facts.version} />

  <main id="main">
    <article class="article container">
      <p class="eyebrow">
        <span class="line" aria-hidden="true"></span>{t('roundup.eyebrow')}
      </p>
      <h1>{t('roundup.h1')}</h1>
      <p class="lede" set:html={t('roundup.lede')} />

      <aside class="callout" set:html={t('roundup.callout')} />

      <!-- How to choose -->
      <section class="block">
        <h2>{t('roundup.choose.h2')}</h2>
        <ul class="chooser">
          {
            m.roundup.choose.items.map((item) => (
              <li>
                <>
                  <span class="need">{item.need}</span>
                  <span class="pick">{item.pick}</span>
                </>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Cards -->
      <section class="block">
        <h2>{t('roundup.field.h2')}</h2>
        <ul class="cards">
          {
            ROUNDUP.map((tool) => (
              <li class:list={['card', { home: tool.homeTeam }]}>
                <div class="card-head">
                  <h3>{tool.name}</h3>
                  {tool.homeTeam && <span class="badge">{t('roundup.field.badge')}</span>}
                </div>
                <p class="runtime">{tool.runtime}</p>
                {tool.homeTeam && (
                  <div class="hl">
                    <span class="hl-eyebrow">
                      {t('roundup.field.hlEyebrow', {
                        version: HUNK_SPLITTING.shippedIn,
                      })}
                    </span>
                    <p class="hl-head">{t('roundup.field.hlHead')}</p>
                    <p class="hl-sub">{t('roundup.field.hlSub')}</p>
                  </div>
                )}
                <p class="strength">{m.roundup.tools[tool.id].strength}</p>
                <div class="card-links">
                  {tool.homeTeam ? (
                    <>
                      <CopyButton
                        text={PRIMARY_INSTALL_COMMAND}
                        label="brew install aic"
                        variant="primary"
                      />
                      <a class="card-link" href={vsAicommits}>
                        {t('roundup.field.vsAicommitsLink')}
                      </a>
                    </>
                  ) : (
                    <>
                      <a
                        class="card-link"
                        href={tool.repo}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {t('roundup.field.repoLink')}
                      </a>
                      {tool.vsPath && (
                        <a class="card-link" href={localizedHref(locale, tool.vsPath)}>
                          {t('roundup.field.compareLink')}
                        </a>
                      )}
                    </>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
        <p class="field-note" set:html={t('roundup.field.note')} />
      </section>

      <!-- Closing -->
      <section class="verdict">
        <h2>{t('roundup.verdict.h2')}</h2>
        <p set:html={t('roundup.verdict.body')} />
        <div class="cta">
          <CopyButton
            text={PRIMARY_INSTALL_COMMAND}
            label="brew tap CaicoLeung/aic && brew install aic"
            variant="primary"
          />
          <a class="cta-link" href={resolve}>{t('footer.nav.resolve')}</a>
          <a class="cta-link" href={vsAicommits}>{t('roundup.verdict.seeVs')}</a>
          <a class="cta-link" href={GITHUB_URL} target="_blank" rel="noopener noreferrer"
            >{t('footer.star')}</a
          >
        </div>
      </section>
    </article>
  </main>

  <Footer />
</Base>

<style>
  .article {
    max-width: 880px;
    padding-block: clamp(2.5rem, 1rem + 4vw, 4.5rem) clamp(3rem, 1rem + 5vw, 5rem);
    position: relative;
    z-index: 2;
  }
  h1 {
    font-size: var(--text-h2);
    line-height: 1.05;
    margin: 0.75rem 0 0;
  }
  .lede {
    color: var(--color-ink-muted);
    line-height: 1.65;
    margin-top: 1rem;
    font-size: var(--text-lede);
  }
  .lede code {
    color: var(--color-amber);
    background: var(--color-amber-soft);
    padding: 0.1rem 0.45rem;
    border-radius: 6px;
    font-size: 0.85em;
  }

  .callout {
    margin-top: 1.75rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-amber);
    border-radius: 10px;
    background: var(--color-amber-soft);
    color: var(--color-ink);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .callout code {
    color: var(--color-amber);
    font-family: var(--font-mono);
  }

  .block {
    margin-top: 2.75rem;
  }
  .block h2 {
    font-size: 1.5rem;
    margin: 0 0 1.1rem;
  }

  /* Chooser */
  .chooser {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .chooser li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--color-line-soft);
    border-radius: 10px;
    background: var(--color-surface);
  }
  .need {
    color: var(--color-ink);
  }
  .pick {
    font-family: var(--font-mono);
    color: var(--color-amber);
    font-size: 0.92rem;
  }

  /* Cards */
  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border: 1px solid var(--color-line-soft);
    border-radius: 14px;
    background: var(--color-surface);
  }
  .card.home {
    border-color: var(--color-amber);
    background: color-mix(in oklch, var(--color-surface) 82%, var(--color-amber-soft));
  }
  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .card h3 {
    font-size: 1.2rem;
    margin: 0;
  }
  .badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1a1408;
    background: var(--color-amber);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
    font-weight: 700;
  }
  .runtime {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-ink-dim);
    margin: 0;
  }
  /* Per-hunk highlight — pulled forward so the differentiator is scannable,
     not buried in the strength paragraph. Home card only. */
  .hl {
    margin: 0.6rem 0;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-amber);
    border-radius: 8px;
    background: rgba(243, 179, 64, 0.06);
  }
  .hl-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-amber);
    font-weight: 600;
  }
  .hl-head {
    margin: 0.3rem 0 0.2rem;
    color: var(--color-ink);
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .hl-sub {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .strength {
    color: var(--color-ink-muted);
    line-height: 1.6;
    font-size: 0.94rem;
    margin: 0.25rem 0 0.75rem;
    flex: 1;
  }
  .card-links {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
  }
  .card-link {
    color: var(--color-amber);
    text-decoration: none;
    font-size: 0.85rem;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) ease;
  }
  .card-link:hover {
    border-bottom-color: var(--color-amber);
  }
  .field-note {
    color: var(--color-ink-dim);
    font-size: 0.88rem;
    line-height: 1.6;
    margin-top: 1.25rem;
  }
  .field-note code {
    font-family: var(--font-mono);
    color: var(--color-ink-muted);
  }

  /* Verdict */
  .verdict {
    margin-top: 2.75rem;
    padding: 1.75rem;
    border: 1px solid var(--color-line-soft);
    border-radius: 14px;
    background: var(--color-surface);
  }
  .verdict h2 {
    font-size: 1.5rem;
    margin: 0 0 0.75rem;
  }
  .verdict p {
    color: var(--color-ink-muted);
    line-height: 1.65;
  }
  .cta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .cta-link {
    color: var(--color-ink);
    text-decoration: none;
    padding: 0.55rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    transition:
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }
  .cta-link:hover {
    border-color: var(--color-amber);
    color: var(--color-amber);
  }
</style>
