---
/**
 * ContentHeader — lightweight header for content pages (vs/, roundup,
 * guides). The home `Topbar` is anchor-coupled (`#how`, `#batching`), so
 * article pages use this simpler, page-safe header instead.
 *
 * Brand links home via BASE_URL (base-path safe). Reuses the Topbar mark.
 *
 * i18n (ADR-0010): strings via `t()`; locale self-determined from URL.
 * Includes the LanguageSwitcher so content pages can switch locale without
 * editing the URL.
 */
import { GITHUB_URL } from '@/config/site';
import { localizedHref, localeFromUrl } from '@/i18n/config';
import { useLocalizer } from '@/i18n/t';
import LanguageSwitcher from '@/components/topbar/LanguageSwitcher.astro';

interface Props {
  readonly version?: string;
}
const { version } = Astro.props;
const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
const home = localizedHref(locale, '');
const changelog = localizedHref(locale, 'changelog');
const versionTitle = version ? t('contentHeader.versionTitle', { version }) : undefined;
---

<header class="content-header">
  <a class="brand" href={home} aria-label="aic — home">
    <span class="mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="20" height="20" focusable="false">
        <path d="M10,5 Q10,13 18,13 Q10,13 10,21 Q10,13 2,13 Q10,13 10,5 Z" fill="#1a1408"
        ></path>
        <path d="M18,2 Q18,6 22,6 Q18,6 18,10 Q18,6 14,6 Q18,6 18,2 Z" fill="#1a1408"
        ></path>
      </svg>
    </span>
    <span class="brand-name">aic</span>
  </a>

  <nav class="content-nav" aria-label="Site">
    {
      version && (
        <a class="version" href={changelog} title={versionTitle}>
          <span class="version-dot" aria-hidden="true" />v{version}
        </a>
      )
    }
    <a href={home}>{t('contentHeader.home')}</a>
    <a href={localizedHref(locale, 'resolve')}>{t('contentHeader.resolve')}</a>
    <a href={localizedHref(locale, 'best-ai-commit-tools')}
      >{t('contentHeader.roundup')}</a
    >
    <a href={localizedHref(locale, 'vs/aicommits')}>{t('contentHeader.compare')}</a>
    <a href={changelog}>{t('contentHeader.changelog')}</a>
    <a
      class="github"
      href={GITHUB_URL}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={t('contentHeader.github')}
      title={t('contentHeader.github')}
    >
      <svg
        class="github-icon"
        viewBox="0 0 16 16"
        width="20"
        height="20"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
        ></path>
      </svg>
    </a>
    <LanguageSwitcher />
  </nav>
</header>

<style>
  .content-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.9rem clamp(1.25rem, 0.4rem + 2vw, 3rem);
    background: color-mix(in oklch, var(--color-base-deep) 78%, transparent);
    border-bottom: 1px solid var(--color-line-soft);
    backdrop-filter: blur(14px) saturate(140%);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: inherit;
  }
  .mark {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: linear-gradient(145deg, var(--color-amber), var(--color-amber-warm));
    display: grid;
    place-items: center;
    box-shadow:
      0 8px 22px -8px rgba(243, 179, 64, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
  }
  .content-nav {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.85rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .content-nav a {
    text-decoration: none;
    color: var(--color-ink-muted);
    transition: color var(--duration-fast) ease;
  }
  .content-nav a:hover {
    color: var(--color-amber);
  }
  /* Version pill + GitHub icon button mirror the home Topbar's .meta
     chrome. ponytail: duplicated from Topbar.astro — both are scoped
     <style> blocks; extract to a global class if a third site nav appears. */
  .content-nav .version {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }
  .content-nav .version:hover {
    color: var(--color-ink);
    border-color: var(--color-amber);
  }
  .version-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-mint);
    box-shadow: 0 0 0 3px var(--color-mint-soft);
  }
  .content-nav .github {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--color-ink);
    text-decoration: none;
    border-radius: 8px;
    transition:
      color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }
  .content-nav .github:hover {
    color: var(--color-amber);
    background: var(--color-amber-soft);
  }
  .github-icon {
    display: block;
  }
  /* Mobile re-flow: brand on its own row, the nav drops to a full-width
     centered row beneath it. Every link stays one-tap reachable — no
     disclosure menu, no JS. Matches the home Topbar's 768px collapse so
     the breakpoint is consistent across the site. */
  @media (max-width: 767px) {
    .content-header {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }
    .content-nav {
      justify-content: center;
    }
  }
  @media (max-width: 480px) {
    .content-nav .version {
      display: none;
    }
  }
</style>
