---
/**
 * /agents/ — Capability page for the CLI-agent backend (ADR-0009, 0015).
 *
 * Uses the Hybrid Hero template: two-column copy + AgentTerminal on top of
 * an article body. The body is narrative-only per ADR-0006 — the full
 * command reference lives in the aic README. The four agent names are
 * illustrative narrative copy, not a build-time-fetched table.
 *
 * Targets tool-finder intent: "aic + Claude Code / Codex / Pi / OpenCode".
 *
 * Rendered by both `/agents/` and `/[locale]/agents/` (ADR-0010). Base
 * self-determines locale from the URL, so the same component serves every
 * locale.
 */
import { loadAicFacts } from '@/data/aic';
import Base from '@/layouts/Base.astro';
import ContentHeader from '@/components/content/ContentHeader.astro';
import Footer from '@/components/footer/Footer.astro';
import CopyButton from '@/components/ui/CopyButton.astro';
import AgentTerminal from '@/components/agents/AgentTerminal.astro';
import { GITHUB_URL, PRIMARY_INSTALL_COMMAND, SITE_ORIGIN } from '@/config/site';
import { localizedHref, localeFromUrl } from '@/i18n/config';
import { useLocalizer, useMessages } from '@/i18n/t';
import { articleSchema, canonicalUrl } from '@/lib/schema';

const facts = await loadAicFacts();
const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
const m = useMessages(locale);
const roundup = localizedHref(locale, 'best-ai-commit-tools');
const releaseUrl = `${GITHUB_URL}/releases/tag/v0.5.0`;

const title = t('meta.agents.title');
const description = t('meta.agents.description');

const site = Astro.site ?? SITE_ORIGIN;
const canonical = canonicalUrl(Astro.url.pathname, site);

const schema = articleSchema({
  headline: title,
  description,
  datePublished: '2026-08-10',
  about: [
    'aic',
    'CLI agent',
    'Claude Code',
    'Codex',
    'Pi',
    'OpenCode',
    'AI coding agent',
  ],
  url: canonical,
  site,
});
---

<Base version={facts.version} title={title} description={description} schema={schema}>
  <ContentHeader version={facts.version} />

  <main id="main">
    <!-- Hybrid Hero (ADR-0009): two-column copy + Terminal, full container width. -->
    <section class="hero-agents container" aria-labelledby="agents-h1">
      <p class="eyebrow agents-eyebrow">
        <span class="line" aria-hidden="true"></span>{t('agents.eyebrow')}
      </p>
      <h1 id="agents-h1" class="agents-h1">
        {t('agents.h1')}
      </h1>

      <div class="agents-terminal">
        <AgentTerminal />
      </div>

      <p class="lede agents-lede" set:html={t('agents.lede')} />

      <div class="agents-cta">
        <CopyButton text={PRIMARY_INSTALL_COMMAND} variant="primary" />
        <span class="cta-hint">
          <span class="arrow" aria-hidden="true">→</span>
          <Fragment set:html={t('agents.ctaHint')} />
        </span>
      </div>
    </section>

    <!-- Article body: narrower prose column. -->
    <article class="article container">
      <!-- How it works -->
      <section class="block">
        <h2>{t('agents.how.h2')}</h2>
        <p class="block-lede">{t('agents.how.lede')}</p>
        <ol class="steps">
          {
            m.agents.how.steps.map((s) => (
              <li>
                <span class="step-h" set:html={s.h} />
                <span class="step-n" set:html={s.n} />
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Four presets -->
      <section class="block">
        <h2>{t('agents.presets.h2')}</h2>
        <p class="block-lede">{t('agents.presets.lede')}</p>
        <ul class="points">
          {
            m.agents.presets.items.map((p) => (
              <li>
                <span class="point-h">{p.h}</span>
                <span class="point-n" set:html={p.n} />
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Either/or -->
      <section class="block">
        <h2>{t('agents.eitherOr.h2')}</h2>
        <p class="block-lede" set:html={t('agents.eitherOr.lede')} />
        <p class="block-body" set:html={t('agents.eitherOr.body')} />
      </section>

      <!-- Custom agents -->
      <section class="block">
        <h2>{t('agents.custom.h2')}</h2>
        <p class="block-body" set:html={t('agents.custom.body')} />
      </section>

      <!-- Speed -->
      <section class="block">
        <h2>{t('agents.speed.h2')}</h2>
        <p class="block-lede">{t('agents.speed.lede')}</p>
        <p class="block-body" set:html={t('agents.speed.body')} />
      </section>

      <!-- Verdict + CTA -->
      <section class="verdict">
        <h2>{t('agents.verdict.h2')}</h2>
        <p set:html={t('agents.verdict.body')} />
        <div class="cta">
          <CopyButton text={PRIMARY_INSTALL_COMMAND} variant="primary" />
          <a class="cta-link" href={roundup}>
            {t('batching.cmpLink')}
          </a>
          <a class="cta-link" href={releaseUrl} target="_blank" rel="noopener noreferrer">
            {t('agents.verdict.releaseNotes')}<span aria-hidden="true"> ↗</span>
          </a>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</Base>

<style>
  /* ── Hybrid Hero — two-column copy + Terminal ── */
  .hero-agents {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-block: clamp(2rem, 1rem + 5vw, 5rem) clamp(2rem, 1rem + 3vw, 3rem);
  }
  .agents-h1 {
    font-size: var(--text-hero);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0;
  }
  .agents-terminal {
    margin-block: 0.5rem;
  }
  .agents-lede {
    font-size: var(--text-lede);
    color: var(--color-ink-muted);
    line-height: 1.65;
    max-width: 32rem;
    margin: 0;
  }
  .agents-lede b {
    color: var(--color-ink);
    font-weight: 600;
  }
  .agents-cta {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .cta-hint {
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
  }
  .cta-hint .arrow {
    color: var(--color-amber);
  }
  .cta-hint code {
    color: var(--color-amber);
    background: var(--color-amber-soft);
    padding: 3px 8px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.78rem;
  }

  @media (min-width: 1024px) {
    .hero-agents {
      display: grid;
      grid-template-columns: 5fr 7fr;
      grid-template-areas:
        'eyebrow  terminal'
        'h1       terminal'
        'lede     terminal'
        'cta      terminal';
      gap: 1.25rem 2.5rem;
      align-items: center;
    }
    .agents-eyebrow {
      grid-area: eyebrow;
    }
    .agents-h1 {
      grid-area: h1;
    }
    .agents-terminal {
      grid-area: terminal;
      margin-block: 0;
    }
    .agents-lede {
      grid-area: lede;
    }
    .agents-cta {
      grid-area: cta;
    }
  }

  /* ── Article body ── */
  .article {
    max-width: 820px;
    padding-block: clamp(1rem, 0.5rem + 2vw, 2rem) clamp(3rem, 1rem + 5vw, 5rem);
    position: relative;
    z-index: 2;
  }
  .block {
    margin-top: 2.75rem;
  }
  .block h2 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
  }
  .block-lede {
    color: var(--color-ink-muted);
    margin: -0.25rem 0 1.25rem;
    line-height: 1.6;
    font-size: 0.975rem;
  }
  .block-body {
    color: var(--color-ink-muted);
    line-height: 1.65;
    font-size: 0.95rem;
    margin: 0;
  }
  .article :global(code) {
    color: var(--color-amber);
    font-family: var(--font-mono);
    background: var(--color-amber-soft);
    padding: 0.1rem 0.4rem;
    border-radius: 5px;
    font-size: 0.85em;
  }

  /* Numbered steps */
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    counter-reset: step;
  }
  .steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 0.85rem;
    align-items: baseline;
  }
  .steps li::before {
    counter-increment: step;
    content: counter(step, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--color-ink-dim);
    padding-top: 0.15rem;
  }
  .step-h {
    grid-column: 2;
    font-weight: 600;
    color: var(--color-ink);
  }
  .step-n {
    grid-column: 2;
    color: var(--color-ink-muted);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Point lists */
  .points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .points li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .point-h {
    font-weight: 600;
    color: var(--color-ink);
  }
  .point-n {
    color: var(--color-ink-muted);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Verdict + CTA */
  .verdict {
    margin-top: 2.75rem;
    padding: 1.75rem;
    border: 1px solid var(--color-line-soft);
    border-radius: 14px;
    background: var(--color-surface);
  }
  .verdict h2 {
    font-size: 1.5rem;
    margin: 0 0 0.75rem;
  }
  .verdict p {
    color: var(--color-ink-muted);
    line-height: 1.65;
  }
  .cta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .cta-link {
    color: var(--color-ink);
    text-decoration: none;
    padding: 0.55rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    transition:
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }
  .cta-link:hover {
    border-color: var(--color-amber);
    color: var(--color-amber);
  }
</style>
