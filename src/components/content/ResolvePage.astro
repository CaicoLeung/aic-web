---
/**
 * /resolve/ — Capability page for `aic resolve` (ADR-0009, CONTEXT.md).
 *
 * Uses the Hybrid Hero template (product register): title-top variant —
 * full-width headline over a lede + ResolveTerminal two-column row — on
 * top of an article body. The body is narrative-only
 * (prose register) per the v0.3.0 content-provenance decision — the full
 * command reference lives in the aic README; this page links to the v0.3.0
 * release as the interim reference until the README documents
 * `aic resolve`.
 *
 * Targets tool-finder intent: "AI merge conflict resolver".
 *
 * Rendered by both `/resolve/` and `/[locale]/resolve/` (ADR-0010). The
 * Article shell self-determines locale, so the same component serves every
 * locale — all prose + meta wire `t()`/`useMessages`; keys a locale leaves
 * stubbed render the EN source via soft parity (Q7=B).
 */
import CopyButton from '@/components/ui/CopyButton.astro';
import HybridHero from '@/components/content/HybridHero.astro';
import ArticleShell from '@/components/content/ArticleShell.astro';
import ResolveTerminal from '@/components/resolve/ResolveTerminal.astro';
import StepHeading, { type StepAccent } from '@/components/content/StepHeading.astro';
import type { IconName } from '@/components/ui/Icon.astro';
import { GITHUB_URL, PRIMARY_INSTALL_COMMAND } from '@/config/site';
import { localizedHref, localeFromUrl } from '@/i18n/config';
import { useLocalizer, useMessages } from '@/i18n/t';

const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
const m = useMessages(locale);
const roundup = localizedHref(locale, 'best-ai-commit-tools');
const releaseUrl = `${GITHUB_URL}/releases/tag/v0.3.0`;

const title = t('meta.resolve.title');
const description = t('meta.resolve.description');

// Icon + accent per workflow step, index-aligned with the i18n steps
// array. Accents follow ADR-0019: cyan = pending/in-flight, mint =
// procedural review, amber-warm = approved-not-yet-committed,
// amber = committed (finalize).
const WORKFLOW_STEPS: [IconName, StepAccent][] = [
  ['eye', 'cyan'],
  ['pen', 'cyan'],
  ['diff', 'mint'],
  ['check', 'amber-warm'],
  ['merge', 'amber'],
];
---

<ArticleShell
  title={title}
  description={description}
  datePublished="2026-07-29"
  about={['aic', 'merge conflicts', 'AI merge conflict resolver', 'git']}
  postHero
>
  <HybridHero
    slot="hero"
    h1Id="resolve-h1"
    titleTop
    eyebrow={t('resolve.eyebrow')}
    lede={t('resolve.lede')}
    ctaHint={t('resolve.ctaHint')}
  >
    <Fragment slot="h1">
      {t('resolve.h1.main')}<br />
      <em class="ital">{m.resolve.h1.sub[0]}</em>{m.resolve.h1.sub[1]}<span class="pop"
        >{m.resolve.h1.sub[2]}</span
      >
    </Fragment>
    <ResolveTerminal slot="terminal" />
  </HybridHero>

  <!-- Article body: narrower prose column. -->
  <section class="block">
    <h2>{t('resolve.workflow.h2')}</h2>
    <p class="block-lede">{t('resolve.workflow.lede')}</p>
    <ol class="steps">
      {
        m.resolve.workflow.steps.map((s, i) => (
          <li>
            <StepHeading
              icon={WORKFLOW_STEPS[i][0]}
              accent={WORKFLOW_STEPS[i][1]}
              h={s.h}
            />
            <span class="step-n" set:html={s.n} />
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Two ways in -->
  <section class="block">
    <h2>{t('resolve.twoWays.h2')}</h2>
    <p class="block-lede">{t('resolve.twoWays.lede')}</p>
    <ul class="points">
      {
        m.resolve.twoWays.points.map((p) => (
          <li>
            <span class="point-h" set:html={p.h} />
            <span class="point-n" set:html={p.n} />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Review before apply -->
  <section class="block">
    <h2>{t('resolve.review.h2')}</h2>
    <p class="block-lede">{t('resolve.review.lede')}</p>
    <aside class="callout flush" set:html={t('resolve.review.callout')} />
  </section>

  <!-- v1 limits -->
  <section class="block">
    <h2>{t('resolve.limits.h2')}</h2>
    <p class="block-lede">{t('resolve.limits.lede')}</p>
    <ul class="points">
      {
        m.resolve.limits.points.map((p) => (
          <li>
            <span class="point-h" set:html={p.h} />
            <span class="point-n" set:html={p.n} />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Verdict + CTA -->
  <section class="verdict">
    <h2>{t('resolve.verdict.h2')}</h2>
    <p set:html={t('resolve.verdict.body')} />
    <div class="cta">
      <CopyButton text={PRIMARY_INSTALL_COMMAND} variant="primary" />
      <a class="cta-link" href={roundup}>
        {t('batching.cmpLink')}
      </a>
      <a class="cta-link" href={releaseUrl} target="_blank" rel="noopener noreferrer">
        {t('resolve.verdict.releaseNotes')}<span aria-hidden="true"> ↗</span>
      </a>
    </div>
  </section>
</ArticleShell>

<style>
  /* Page-unique styles: the h1 accent markup slotted into HybridHero.
     The article CSS layer (.article namespace) lives in ArticleShell. */
  .ital {
    font-style: italic;
    font-weight: 700;
    color: var(--color-ink-muted);
  }
  .pop {
    color: var(--color-amber);
  }
</style>
