---
/**
 * /resolve/ — Capability page for `aic resolve` (ADR-0009, CONTEXT.md).
 *
 * First content page to use the Hybrid Hero template (product register):
 * two-column copy + ResolveTerminal on top of an article body. The body is
 * narrative-only (prose register) per the v0.3.0 content-provenance decision
 * — the full command reference lives in the aic README; this page links to
 * the v0.3.0 release as the interim reference until the README documents
 * `aic resolve`.
 *
 * Targets tool-finder intent: "AI merge conflict resolver".
 *
 * Rendered by both `/resolve/` and `/[locale]/resolve/` (ADR-0010). Base
 * self-determines locale from the URL, so the same component serves every
 * locale — all prose + meta wire `t()`/`useMessages`; keys a locale leaves
 * stubbed render the EN source via soft parity (Q7=B).
 */
import { loadAicFacts } from '@/data/aic';
import Base from '@/layouts/Base.astro';
import ContentHeader from '@/components/content/ContentHeader.astro';
import Footer from '@/components/footer/Footer.astro';
import CopyButton from '@/components/ui/CopyButton.astro';
import ResolveTerminal from '@/components/resolve/ResolveTerminal.astro';
import { GITHUB_URL, PRIMARY_INSTALL_COMMAND } from '@/config/site';
import { localizedHref, localeFromUrl } from '@/i18n/config';
import { useLocalizer, useMessages } from '@/i18n/t';

const facts = await loadAicFacts();
const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
const m = useMessages(locale);
const roundup = localizedHref(locale, 'best-ai-commit-tools');
const releaseUrl = `${GITHUB_URL}/releases/tag/v0.3.0`;

const title = t('meta.resolve.title');
const description = t('meta.resolve.description');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: '2026-07-29',
  dateModified: '2026-07-29',
  author: { '@type': 'Organization', name: 'aic' },
  publisher: { '@type': 'Organization', name: 'aic' },
  about: ['aic', 'merge conflicts', 'AI merge conflict resolver', 'git'],
};
---

<Base version={facts.version} title={title} description={description} schema={schema}>
  <ContentHeader version={facts.version} />

  <main id="main">
    <!-- Hybrid Hero (ADR-0009): two-column copy + Terminal, full container width. -->
    <section class="hero-resolve container" aria-labelledby="resolve-h1">
      <p class="eyebrow resolve-eyebrow">
        <span class="line" aria-hidden="true"></span>{t('resolve.eyebrow')}
      </p>
      <h1 id="resolve-h1" class="resolve-h1">
        {t('resolve.h1.main')}<br />
        <em class="ital">{m.resolve.h1.sub[0]}</em>{m.resolve.h1.sub[1]}<span class="pop"
          >{m.resolve.h1.sub[2]}</span
        >
      </h1>

      <div class="resolve-terminal">
        <ResolveTerminal />
      </div>

      <p class="lede resolve-lede" set:html={t('resolve.lede')} />

      <div class="resolve-cta">
        <CopyButton text={PRIMARY_INSTALL_COMMAND} variant="primary" />
        <span class="cta-hint">
          <span class="arrow" aria-hidden="true">→</span>
          <Fragment set:html={t('resolve.ctaHint')} />
        </span>
      </div>
    </section>

    <!-- Article body: narrower prose column. -->
    <article class="article container">
      <!-- The workflow -->
      <section class="block">
        <h2>{t('resolve.workflow.h2')}</h2>
        <p class="block-lede">{t('resolve.workflow.lede')}</p>
        <ol class="steps">
          {
            m.resolve.workflow.steps.map((s) => (
              <li>
                <span class="step-h" set:html={s.h} />
                <span class="step-n" set:html={s.n} />
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Two ways in -->
      <section class="block">
        <h2>{t('resolve.twoWays.h2')}</h2>
        <p class="block-lede">{t('resolve.twoWays.lede')}</p>
        <ul class="points">
          {
            m.resolve.twoWays.points.map((p) => (
              <li>
                <span class="point-h" set:html={p.h} />
                <span class="point-n" set:html={p.n} />
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Review before apply -->
      <section class="block">
        <h2>{t('resolve.review.h2')}</h2>
        <p class="block-lede">{t('resolve.review.lede')}</p>
        <aside class="callout" set:html={t('resolve.review.callout')} />
      </section>

      <!-- v1 limits -->
      <section class="block">
        <h2>{t('resolve.limits.h2')}</h2>
        <p class="block-lede">{t('resolve.limits.lede')}</p>
        <ul class="points">
          {
            m.resolve.limits.points.map((p) => (
              <li>
                <span class="point-h" set:html={p.h} />
                <span class="point-n" set:html={p.n} />
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Verdict + CTA -->
      <section class="verdict">
        <h2>{t('resolve.verdict.h2')}</h2>
        <p set:html={t('resolve.verdict.body')} />
        <div class="cta">
          <CopyButton text={PRIMARY_INSTALL_COMMAND} variant="primary" />
          <a class="cta-link" href={roundup}>
            {t('batching.cmpLink')}
          </a>
          <a class="cta-link" href={releaseUrl} target="_blank" rel="noopener noreferrer">
            {t('resolve.verdict.releaseNotes')}<span aria-hidden="true"> ↗</span>
          </a>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</Base>

<style>
  /* ── Hybrid Hero — two-column copy + Terminal, mirroring the home Hero grid ── */
  .hero-resolve {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-block: clamp(2rem, 1rem + 5vw, 5rem) clamp(2rem, 1rem + 3vw, 3rem);
  }
  .resolve-h1 {
    font-size: var(--text-hero);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0;
  }
  .resolve-h1 .ital {
    font-style: italic;
    font-weight: 700;
    color: var(--color-ink-muted);
  }
  .resolve-h1 .pop {
    color: var(--color-amber);
  }
  .resolve-terminal {
    margin-block: 0.5rem;
  }
  .resolve-lede {
    font-size: var(--text-lede);
    color: var(--color-ink-muted);
    line-height: 1.65;
    max-width: 32rem;
    margin: 0;
  }
  .resolve-lede b {
    color: var(--color-ink);
    font-weight: 600;
  }
  .resolve-cta {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .cta-hint {
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
  }
  .cta-hint .arrow {
    color: var(--color-amber);
  }
  .cta-hint code {
    color: var(--color-amber);
    background: var(--color-amber-soft);
    padding: 3px 8px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.78rem;
  }

  @media (min-width: 1024px) {
    .hero-resolve {
      display: grid;
      grid-template-columns: 5fr 7fr;
      grid-template-areas:
        'eyebrow  terminal'
        'h1       terminal'
        'lede     terminal'
        'cta      terminal';
      gap: 1.25rem 2.5rem;
      align-items: center;
    }
    .resolve-eyebrow {
      grid-area: eyebrow;
    }
    .resolve-h1 {
      grid-area: h1;
    }
    .resolve-terminal {
      grid-area: terminal;
      margin-block: 0;
    }
    .resolve-lede {
      grid-area: lede;
    }
    .resolve-cta {
      grid-area: cta;
    }
  }

  /* ── Article body — narrower prose column ── */
  .article {
    max-width: 820px;
    padding-block: clamp(1rem, 0.5rem + 2vw, 2rem) clamp(3rem, 1rem + 5vw, 5rem);
    position: relative;
    z-index: 2;
  }
  .block {
    margin-top: 2.75rem;
  }
  .block h2 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
  }
  .block-lede {
    color: var(--color-ink-muted);
    margin: -0.25rem 0 1.25rem;
    line-height: 1.6;
    font-size: 0.975rem;
  }
  .article :global(code) {
    color: var(--color-amber);
    font-family: var(--font-mono);
    background: var(--color-amber-soft);
    padding: 0.1rem 0.4rem;
    border-radius: 5px;
    font-size: 0.85em;
  }

  /* Numbered workflow steps */
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    counter-reset: step;
  }
  .steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 0.85rem;
    align-items: baseline;
  }
  .steps li::before {
    counter-increment: step;
    content: counter(step, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--color-ink-dim);
    padding-top: 0.15rem;
  }
  .step-h {
    grid-column: 2;
    font-weight: 600;
    color: var(--color-ink);
  }
  .step-n {
    grid-column: 2;
    color: var(--color-ink-muted);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Point lists */
  .points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .points li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .point-h {
    font-weight: 600;
    color: var(--color-ink);
  }
  .point-n {
    color: var(--color-ink-muted);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Callout */
  .callout {
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-amber);
    border-radius: 10px;
    background: var(--color-amber-soft);
    color: var(--color-ink);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .callout :global(code) {
    color: var(--color-amber);
  }

  /* Verdict + CTA */
  .verdict {
    margin-top: 2.75rem;
    padding: 1.75rem;
    border: 1px solid var(--color-line-soft);
    border-radius: 14px;
    background: var(--color-surface);
  }
  .verdict h2 {
    font-size: 1.5rem;
    margin: 0 0 0.75rem;
  }
  .verdict p {
    color: var(--color-ink-muted);
    line-height: 1.65;
  }
  .cta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .cta-link {
    color: var(--color-ink);
    text-decoration: none;
    padding: 0.55rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    transition:
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }
  .cta-link:hover {
    border-color: var(--color-amber);
    color: var(--color-amber);
  }
</style>
