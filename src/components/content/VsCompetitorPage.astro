---
/**
 * /vs/{id} — head-to-head comparison page (ADR-0006).
 *
 * Generic over competitor id (aicommits | ai-commit | llmc). Fair by design
 * (CONTEXT.md → "vs page"): concedes where the rival wins, wins decisively
 * on aic's differentiators. Comparison facts are editorial judgments from
 * `src/config/competitors.ts`, verified against both READMEs and repo data
 * (see `competitor-profiles/`).
 *
 * Targets the "{rival} alternative" / migration cluster. Article schema
 * (not SoftwareApplication) since this is content, not the app listing.
 *
 * Rendered by both `/vs/{id}/` and `/[locale]/vs/{id}/` (ADR-0010). Base
 * self-determines locale; all prose + meta wire `t()`/`useMessages`; stubbed
 * keys fall back to EN (soft parity, Q7=B).
 */
import { loadAicFacts } from '@/data/aic';
import Base from '@/layouts/Base.astro';
import ContentHeader from '@/components/content/ContentHeader.astro';
import Footer from '@/components/footer/Footer.astro';
import CopyButton from '@/components/ui/CopyButton.astro';
import type { CompetitorComparison } from '@/config/competitors';
import { GITHUB_URL, PRIMARY_INSTALL_COMMAND } from '@/config/site';
import { localeFromUrl, localizedHref } from '@/i18n/config';
import { useLocalizer, useMessages } from '@/i18n/t';

/** Message-block keys under `meta.vs` and `vs` in the locale modules. */
type VsKey = 'aicommits' | 'ai-commit' | 'llmc';

interface Props {
  /** Locale message-block key for this comparison. */
  id: VsKey;
  /** Editorial comparison data (src/config/competitors.ts). */
  comparison: CompetitorComparison;
  datePublished?: string;
  dateModified?: string;
}

const {
  id,
  comparison,
  datePublished = '2026-08-01',
  dateModified = '2026-08-01',
} = Astro.props;

const facts = await loadAicFacts();
const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
const m = useMessages(locale);
const vsBlock = m.vs[id];
const L = vsBlock.axes;
const { rival, axes } = comparison;
const aicWins = axes.filter((a) => a.winner === 'aic');
const rivalWins = axes.filter((a) => a.winner === 'rival');
const ties = axes.filter((a) => a.winner === 'tie');

const title = t(`meta.vs.${id}.title`);
const description = t(`meta.vs.${id}.description`);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished,
  dateModified,
  author: { '@type': 'Organization', name: 'aic' },
  publisher: { '@type': 'Organization', name: 'aic' },
  about: ['aic', rival.name, 'AI commit message tools'],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: vsBlock.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const schema = [articleSchema, faqSchema];
---

<Base version={facts.version} title={title} description={description} schema={schema}>
  <ContentHeader version={facts.version} />

  <main id="main">
    <article class="article container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={localizedHref(locale, '')}>{t('contentHeader.home')}</a>
        <span aria-hidden="true">›</span>
        <a href={localizedHref(locale, 'best-ai-commit-tools')}
          >{t('footer.nav.roundup')}</a
        >
        <span aria-hidden="true">›</span>
        <span aria-current="page">{vsBlock.h1}</span>
      </nav>
      <p class="eyebrow">
        <span class="line" aria-hidden="true"></span>{vsBlock.eyebrow}
      </p>
      <h1>{vsBlock.h1}</h1>
      <p class="lede">
        <a href={rival.repo} target="_blank" rel="noopener noreferrer">{rival.name}</a
        ><Fragment set:html={vsBlock.ledeAfter} />
      </p>

      <aside class="callout" set:html={vsBlock.callout} />

      <!-- Feature matrix -->
      <section class="block">
        <h2>{vsBlock.matrix.heading}</h2>
        <div class="table-wrap">
          <table class="matrix">
            <thead>
              <tr>
                <th scope="col">{vsBlock.matrix.capability}</th>
                <th scope="col">{vsBlock.matrix.aic}</th>
                <th scope="col">{rival.name}</th>
              </tr>
            </thead>
            <tbody>
              {
                axes.map((axis) => (
                  <tr>
                    <th scope="row">{L[axis.id].feature}</th>
                    <td class={axis.winner === 'aic' ? 'win' : ''}>
                      {axis.aic.supported === true && (
                        <span class="glyph yes" aria-hidden="true">
                          ✓
                        </span>
                      )}
                      {axis.aic.supported === false && (
                        <span class="glyph no" aria-hidden="true">
                          ✗
                        </span>
                      )}
                      <span>{L[axis.id].aic}</span>
                    </td>
                    <td class={axis.winner === 'rival' ? 'win' : ''}>
                      {axis.rival.supported === true && (
                        <span class="glyph yes" aria-hidden="true">
                          ✓
                        </span>
                      )}
                      {axis.rival.supported === false && (
                        <span class="glyph no" aria-hidden="true">
                          ✗
                        </span>
                      )}
                      <span>{L[axis.id].rival}</span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <p class="inline-cta">
        <a href="#cta">{m.vs.more.installCta}</a>
      </p>

      <!-- Where aic wins -->
      <section class="block">
        <h2>{vsBlock.winsH2}</h2>
        <ul class="points">
          {
            aicWins.map((axis) => (
              <li>
                <span class="point-h">{L[axis.id].feature}</span>
                <span class="point-n">{L[axis.id].note}</span>
              </li>
            ))
          }
          {
            ties.map((axis) => (
              <li>
                <span class="point-h">
                  {L[axis.id].feature} <span class="tie-tag">{vsBlock.tieTag}</span>
                </span>
                <span class="point-n">{L[axis.id].note}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Where the rival wins (the fair concession) -->
      <section class="block">
        <h2>{vsBlock.rivalH2}</h2>
        <p class="block-lede">{vsBlock.rivalLede}</p>
        <ul class="points">
          {
            rivalWins.map((axis) => (
              <li>
                <span class="point-h">{L[axis.id].feature}</span>
                <span class="point-n">{L[axis.id].note}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- FAQ (migration-intent keywords + FAQPage schema) -->
      <section class="block">
        <h2>{vsBlock.faq.h2}</h2>
        <div class="faq">
          {
            vsBlock.faq.items.map((item) => (
              <div class="faq-item">
                <h3>{item.q}</h3>
                <p>{item.a}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- More comparisons (spoke-to-spoke internal links) -->
      <section class="more block">
        <h2>{m.vs.more.h2}</h2>
        <ul class="more-links">
          {
            id !== 'aicommits' && (
              <li>
                <a href={localizedHref(locale, 'vs/aicommits')}>{m.vs.more.aicommits}</a>
              </li>
            )
          }
          {
            id !== 'ai-commit' && (
              <li>
                <a href={localizedHref(locale, 'vs/ai-commit')}>{m.vs.more.aiCommit}</a>
              </li>
            )
          }
          {
            id !== 'llmc' && (
              <li>
                <a href={localizedHref(locale, 'vs/llmc')}>{m.vs.more.llmc}</a>
              </li>
            )
          }
          {
            id !== 'git-ai' && (
              <li>
                <a href={localizedHref(locale, 'vs/git-ai')}>{m.vs.more.gitAi}</a>
              </li>
            )
          }
          {
            id !== 'opencommit' && (
              <li>
                <a href={localizedHref(locale, 'vs/opencommit')}>
                  {m.vs.more.opencommit}
                </a>
              </li>
            )
          }
          <li>
            <a href={localizedHref(locale, 'best-ai-commit-tools')}>{m.vs.more.roundup}</a
            >
          </li>
        </ul>
      </section>

      <!-- Verdict + CTA -->
      <section class="verdict" id="cta">
        <h2>{vsBlock.verdict.h2}</h2>
        <p set:html={vsBlock.verdict.body} />
        <div class="cta">
          <CopyButton text={PRIMARY_INSTALL_COMMAND} variant="primary" />
          <a class="cta-link" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
            {t('footer.star')}
          </a>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</Base>

<style>
  .article {
    max-width: 820px;
    padding-block: clamp(2.5rem, 1rem + 4vw, 4.5rem) clamp(3rem, 1rem + 5vw, 5rem);
    position: relative;
    z-index: 2;
  }
  h1 {
    font-size: var(--text-h2);
    line-height: 1.05;
    margin: 0.75rem 0 0;
  }
  .lede {
    color: var(--color-ink-muted);
    line-height: 1.65;
    margin-top: 1rem;
    font-size: var(--text-lede);
  }
  .lede a {
    color: var(--color-amber);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklch, var(--color-amber) 40%, transparent);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-ink-dim);
    margin-bottom: 0.5rem;
  }
  .crumbs a {
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--color-amber);
  }
  .crumbs span[aria-current='page'] {
    color: var(--color-ink);
  }

  .callout {
    margin-top: 1.75rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-amber);
    border-radius: 10px;
    background: var(--color-amber-soft);
    color: var(--color-ink);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .callout code {
    color: var(--color-amber);
    font-family: var(--font-mono);
  }

  .block {
    margin-top: 2.75rem;
  }
  .block h2 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
  }
  .block-lede {
    color: var(--color-ink-muted);
    margin: -0.25rem 0 1.25rem;
    line-height: 1.6;
    font-size: 0.975rem;
  }

  /* Matrix table */
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-line-soft);
    border-radius: 12px;
  }
  .matrix {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    min-width: 520px;
  }
  .matrix th,
  .matrix td {
    text-align: left;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--color-line-soft);
    vertical-align: top;
  }
  .matrix thead th {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    background: var(--color-surface);
  }
  .matrix tbody th {
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--color-ink);
    max-width: 16rem;
  }
  .matrix tbody tr:last-child th,
  .matrix tbody tr:last-child td {
    border-bottom: none;
  }
  .matrix td {
    color: var(--color-ink-muted);
  }
  .matrix td.win {
    color: var(--color-ink);
    background: var(--color-amber-soft);
  }
  .glyph {
    font-weight: 700;
    margin-right: 0.4rem;
  }
  .glyph.yes {
    color: var(--color-mint);
  }
  .glyph.no {
    color: var(--color-ink-dim);
  }

  /* Point lists */
  .points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .points li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .point-h {
    font-weight: 600;
    color: var(--color-ink);
  }
  .point-n {
    color: var(--color-ink-muted);
    line-height: 1.6;
    font-size: 0.95rem;
  }
  .tie-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-dim);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.05rem 0.45rem;
    margin-left: 0.4rem;
    vertical-align: middle;
  }

  /* FAQ */
  .faq {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .faq-item h3 {
    font-size: 1rem;
    margin: 0 0 0.35rem;
    color: var(--color-ink);
  }
  .faq-item p {
    color: var(--color-ink-muted);
    line-height: 1.6;
    font-size: 0.95rem;
    margin: 0;
  }

  /* More comparisons */
  .more-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }
  .more-links a {
    color: var(--color-amber);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklch, var(--color-amber) 40%, transparent);
    font-size: 0.95rem;
  }
  .more-links a:hover {
    color: var(--color-ink);
  }

  /* Verdict */
  .verdict {
    margin-top: 2.75rem;
    padding: 1.75rem;
    border: 1px solid var(--color-line-soft);
    border-radius: 14px;
    background: var(--color-surface);
  }
  .verdict h2 {
    font-size: 1.5rem;
    margin: 0 0 0.75rem;
  }
  .verdict p {
    color: var(--color-ink-muted);
    line-height: 1.65;
  }
  .verdict code {
    color: var(--color-amber);
    font-family: var(--font-mono);
  }
  .cta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .cta-link {
    color: var(--color-ink);
    text-decoration: none;
    padding: 0.55rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    transition:
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }
  .cta-link:hover {
    border-color: var(--color-amber);
    color: var(--color-amber);
  }

  .inline-cta {
    margin-top: 1.5rem;
  }
  .inline-cta a {
    color: var(--color-amber);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklch, var(--color-amber) 40%, transparent);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .inline-cta a:hover {
    color: var(--color-ink);
  }
</style>
