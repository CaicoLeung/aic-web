---
/**
 * /vs/{id} — head-to-head comparison page (ADR-0006).
 *
 * Generic over competitor id. Fair by design
 * (CONTEXT.md → "vs page"): concedes where the rival wins, wins decisively
 * on aic's differentiators. Comparison facts are editorial judgments from
 * `src/config/competitors.ts`, verified against both READMEs and repo data
 * (see `competitor-profiles/`). The set of rivals with a page is whatever
 * `COMPARISONS` exposes — there is no parallel type to keep in sync.
 *
 * Targets the "{rival} alternative" / migration cluster. Article schema
 * (not SoftwareApplication) since this is content, not the app listing.
 *
 * Rendered by both `/vs/{id}/` and `/[locale]/vs/{id}/` (ADR-0010). The
 * Article shell self-determines locale; all prose + meta wire
 * `t()`/`useMessages`; stubbed keys fall back to EN (soft parity, Q7=B).
 */
import CopyButton from '@/components/ui/CopyButton.astro';
import ArticleShell from '@/components/content/ArticleShell.astro';
import {
  COMPARISONS,
  COMPARISON_RIVALS,
  type CompetitorComparison,
} from '@/config/competitors';
import { GITHUB_URL, PRIMARY_INSTALL_COMMAND } from '@/config/site';
import { localizedHref, localeFromUrl } from '@/i18n/config';
import { assertRivalMessages } from '@/i18n/assert';
import { useLocalizer, useMessages } from '@/i18n/t';
import FeatureMatrix from '@/components/content/FeatureMatrix.astro';

interface Props {
  /**
   * Editorial comparison data (`src/config/competitors.ts`). The rival id is
   * the single source of truth for the message-block key, the route, and the
   * "More comparisons" filter — there is no separate `id` prop, so the type
   * contract can never drift from the rivals that actually have a page.
   */
  comparison: CompetitorComparison;
}

const { comparison } = Astro.props;

// Derive every id-keyed lookup from the data: message block, breadcrumb,
// and the More-comparisons filter all read this, not a parallel prop.
const id = comparison.rival.id;

const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
const m = useMessages(locale);
// Build-time gate: a missing i18n block for this rival fails the build with a
// clear message. tsc can't catch this — `.astro` frontmatter isn't type-checked
// (ADR-0007) and `m.vs[id]` is a string index.
assertRivalMessages(m, id);
const vsBlock = m.vs[id];
const { rival, axes } = comparison;
const aicWins = axes.filter((a) => a.winner === 'aic');
const rivalWins = axes.filter((a) => a.winner === 'rival');
const ties = axes.filter((a) => a.winner === 'tie');

const title = t(`meta.vs.${id}.title`);
const description = t(`meta.vs.${id}.description`);
---

<ArticleShell
  title={title}
  description={description}
  datePublished="2026-08-01"
  dateModified="2026-08-01"
  about={['aic', rival.name, 'AI commit message tools']}
  faq={vsBlock.faq.items}
  crumbs={[
    { name: t('contentHeader.home'), path: '' },
    { name: t('footer.nav.roundup'), path: 'best-ai-commit-tools' },
    { name: vsBlock.h1, path: '' },
  ]}
>
  <p class="eyebrow">
    <span class="line" aria-hidden="true"></span>{vsBlock.eyebrow}
  </p>
  <h1>{vsBlock.h1}</h1>
  <p class="lede">
    <a href={rival.repo} target="_blank" rel="noopener noreferrer">{rival.name}</a
    ><Fragment set:html={vsBlock.ledeAfter} />
  </p>

  <aside class="callout" set:html={vsBlock.callout} />

  <!-- Feature matrix -->
  <FeatureMatrix
    axes={axes}
    axisLabels={vsBlock.axes}
    rivalName={rival.name}
    labels={m.vs.matrix}
  />

  <p class="inline-cta">
    <a href="#cta">{m.vs.more.installCta}</a>
  </p>

  <!-- Where aic wins -->
  <section class="block">
    <h2>{vsBlock.winsH2}</h2>
    <ul class="points">
      {
        aicWins.map((axis) => (
          <li>
            <span class="point-h">{vsBlock.axes[axis.id].feature}</span>
            <span class="point-n">{vsBlock.axes[axis.id].note}</span>
          </li>
        ))
      }
      {
        ties.map((axis) => (
          <li>
            <span class="point-h">
              {vsBlock.axes[axis.id].feature}{' '}
              <span class="tie-tag">{vsBlock.tieTag}</span>
            </span>
            <span class="point-n">{vsBlock.axes[axis.id].note}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Where the rival wins (the fair concession) -->
  <section class="block">
    <h2>{vsBlock.rivalH2}</h2>
    <p class="block-lede">{vsBlock.rivalLede}</p>
    <ul class="points">
      {
        rivalWins.map((axis) => (
          <li>
            <span class="point-h">{vsBlock.axes[axis.id].feature}</span>
            <span class="point-n">{vsBlock.axes[axis.id].note}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- FAQ (migration-intent keywords + FAQPage schema) -->
  <section class="block">
    <h2>{vsBlock.faq.h2}</h2>
    <div class="faq">
      {
        vsBlock.faq.items.map((item) => (
          <div class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- More comparisons (spoke-to-spoke internal links) -->
  <section class="more block">
    <h2>{m.vs.more.h2}</h2>
    <ul class="more-links">
      {
        COMPARISON_RIVALS.filter((rivalId) => rivalId !== id).map((rivalId) => (
          <li>
            <a href={localizedHref(locale, `vs/${rivalId}`)}>
              {t('vs.more.vsLabel', { name: COMPARISONS[rivalId].rival.name })}
            </a>
          </li>
        ))
      }
      <li>
        <a href={localizedHref(locale, 'best-ai-commit-tools')}>{m.vs.more.roundup}</a>
      </li>
    </ul>
  </section>

  <!-- Verdict + CTA (spec §6: roundup back-link lives in the verdict/more area) -->
  <section class="verdict" id="cta">
    <h2>{vsBlock.verdict.h2}</h2>
    <p set:html={vsBlock.verdict.body} />
    <div class="cta">
      <CopyButton text={PRIMARY_INSTALL_COMMAND} variant="primary" />
      <a class="cta-link" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
        {t('footer.star')}
      </a>
    </div>
    <p class="verdict-roundup">
      <a href={localizedHref(locale, 'best-ai-commit-tools')}>{m.vs.more.roundup}</a>
    </p>
  </section>
</ArticleShell>

<style>
  /* Page-unique styles. The article CSS layer (.article namespace) lives in
     ArticleShell. */
  .lede a {
    color: var(--color-amber);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklch, var(--color-amber) 40%, transparent);
  }

  .tie-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-dim);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.05rem 0.45rem;
    margin-left: 0.4rem;
    vertical-align: middle;
  }

  /* More comparisons */
  .more-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }
  .more-links a {
    color: var(--color-amber);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklch, var(--color-amber) 40%, transparent);
    font-size: 0.95rem;
  }
  .more-links a:hover {
    color: var(--color-ink);
  }

  .verdict-roundup {
    margin: 1.25rem 0 0;
  }
  .verdict-roundup a {
    color: var(--color-amber);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklch, var(--color-amber) 40%, transparent);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .verdict-roundup a:hover {
    color: var(--color-ink);
  }
</style>
