---
/**
 * /changelog — release-by-release history for aic.
 *
 * Rendered from build-time `loadChangelog()` (ADR-0003 pattern; ADR-0008
 * carve-out for the failure contract). Fails the whole build if both the
 * raw CHANGELOG.md and the GitHub Releases API are unreachable.
 *
 * Rendered by both `/changelog/` and `/[locale]/changelog/` (ADR-0010).
 * The body is fetched EN markdown and stays EN in every locale (ADR-0011);
 * Base self-determines locale for chrome + hreflang. The localized
 * "release notes are in English" note (ADR-0011) is pending the
 * t()-wiring pass.
 */
import { loadAicFacts } from '@/data/aic';
import { loadChangelog } from '@/data/changelog';
import Base from '@/layouts/Base.astro';
import ContentHeader from '@/components/content/ContentHeader.astro';
import Footer from '@/components/footer/Footer.astro';
import Changelog from '@/components/changelog/Changelog.astro';
import { GITHUB_URL } from '@/config/site';
import { localeFromUrl, DEFAULT_LOCALE } from '@/i18n/config';
import { useTranslations } from '@/i18n/t';

const facts = await loadAicFacts();
const entries = await loadChangelog();

const locale = localeFromUrl(Astro.url.pathname);
const t = useTranslations(locale);

const latest = entries[0];
const earliest = entries[entries.length - 1];

const title = 'aic changelog — every release';
const description = `Every aic release in order — features, fixes, and notes as they shipped. Latest: v${latest?.version}.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: earliest?.date,
  dateModified: latest?.date,
  author: { '@type': 'Organization', name: 'aic' },
  publisher: { '@type': 'Organization', name: 'aic' },
  about: ['aic', 'changelog', 'release notes', 'git'],
};
---

<Base version={facts.version} title={title} description={description} schema={schema}>
  <ContentHeader version={facts.version} />

  <main id="main">
    <article class="container article">
      <p class="eyebrow"><span class="line" aria-hidden="true"></span>{t('changelog.eyebrow')}</p>
      <h1>{t('changelog.h1')}</h1>
      <p class="lede"><Fragment set:html={t('changelog.ledeBefore')} /><a
          class="inline-link"
          href={`${GITHUB_URL}/blob/main/CHANGELOG.md`}
          target="_blank"
          rel="noopener noreferrer">{t('changelog.ledeLink')}</a><Fragment set:html={t('changelog.ledeAfter')} /></p>

      {locale !== DEFAULT_LOCALE && (
        <p class="en-note" role="note">{t('changelog.englishNote')}</p>
      )}

      <Changelog entries={entries} />
    </article>
  </main>

  <Footer />
</Base>

<style>
  .article {
    max-width: 880px;
    padding-block: clamp(2.5rem, 1rem + 4vw, 4.5rem) clamp(3rem, 1rem + 5vw, 5rem);
    position: relative;
    z-index: 2;
  }
  h1 {
    font-size: var(--text-h2);
    line-height: 1.05;
    margin: 0.75rem 0 0;
  }
  .lede {
    color: var(--color-ink-muted);
    line-height: 1.65;
    margin-top: 1rem;
    font-size: var(--text-lede);
  }
  .lede code {
    color: var(--color-amber);
    background: var(--color-amber-soft);
    padding: 0.1rem 0.45rem;
    border-radius: 6px;
    font-size: 0.85em;
  }
  .inline-link {
    color: var(--color-amber);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklch, var(--color-amber) 40%, transparent);
    transition: border-color var(--duration-fast) ease;
  }
  .inline-link:hover {
    border-bottom-color: var(--color-amber);
  }
  .en-note {
    margin-top: 0.5rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--color-line-soft);
    border-left: 3px solid var(--color-ink-dim);
    border-radius: 8px;
    background: var(--color-surface);
    color: var(--color-ink-muted);
    font-size: 0.88rem;
  }
</style>
