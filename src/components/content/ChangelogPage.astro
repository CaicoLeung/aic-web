---
/**
 * /changelog — release-by-release history for aic.
 *
 * Rendered from build-time `loadChangelog()` (ADR-0003 pattern; ADR-0008
 * carve-out for the failure contract). Fails the whole build if both the
 * raw CHANGELOG.md and the GitHub Releases API are unreachable.
 *
 * Rendered by both `/changelog/` and `/[locale]/changelog/` (ADR-0010).
 * The body is fetched EN markdown and stays EN in every locale (ADR-0011);
 * the shell self-determines locale for chrome + hreflang. The localized
 * "release notes are in English" note (ADR-0011) renders via
 * `t('changelog.englishNote')` on non-en locales.
 *
 * Takes the Article shell's thin path: entry dates are dynamic (earliest
 * published / latest modified), so the hand-built Article schema is passed
 * directly instead of the ritual props.
 */
import { loadChangelog } from '@/data/changelog';
import ArticleShell from '@/components/content/ArticleShell.astro';
import Changelog from '@/components/changelog/Changelog.astro';
import { GITHUB_URL } from '@/config/site';
import { localeFromUrl, DEFAULT_LOCALE } from '@/i18n/config';
import { useLocalizer } from '@/i18n/t';

const entries = await loadChangelog();

const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);

const latest = entries[0];
const earliest = entries[entries.length - 1];

const title = t('meta.changelog.title');
const description = t('meta.changelog.description', {
  version: latest?.version ?? '',
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: earliest?.date,
  dateModified: latest?.date,
  author: { '@type': 'Organization', name: 'aic' },
  publisher: { '@type': 'Organization', name: 'aic' },
  about: ['aic', 'changelog', 'release notes', 'git'],
};
---

<ArticleShell title={title} description={description} schema={schema}>
  <p class="eyebrow">
    <span class="line" aria-hidden="true"></span>{t('changelog.eyebrow')}
  </p>
  <h1>{t('changelog.h1')}</h1>
  <p class="lede">
    <Fragment set:html={t('changelog.ledeBefore')} /><a
      class="inline-link"
      href={`${GITHUB_URL}/blob/main/CHANGELOG.md`}
      target="_blank"
      rel="noopener noreferrer">{t('changelog.ledeLink')}</a
    ><Fragment set:html={t('changelog.ledeAfter')} />
  </p>

  {
    locale !== DEFAULT_LOCALE && (
      <p class="en-note" role="note">
        {t('changelog.englishNote')}
      </p>
    )
  }

  <Changelog entries={entries} />
</ArticleShell>

<style>
  /* Page-unique styles. The article CSS layer (.article namespace) lives in
     ArticleShell. */
  .inline-link {
    color: var(--color-amber);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklch, var(--color-amber) 40%, transparent);
    transition: border-color var(--duration-fast) ease;
  }
  .inline-link:hover {
    border-bottom-color: var(--color-amber);
  }
  .en-note {
    margin-top: 0.5rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--color-line-soft);
    border-left: 3px solid var(--color-ink-dim);
    border-radius: 8px;
    background: var(--color-surface);
    color: var(--color-ink-muted);
    font-size: 0.88rem;
  }
</style>
