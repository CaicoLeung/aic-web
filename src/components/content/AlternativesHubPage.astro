---
/**
 * /alternatives/ — migration-intent hub (ADR-0006).
 *
 * Ranks aic's alternatives by why each user base might switch, linking to
 * each singular /alternatives/{id} page. Honest by design: it concedes
 * where staying makes sense (each card's one-liner is the switch case).
 *
 * Rendered by both `/alternatives/` and `/[locale]/alternatives/` (ADR-0010).
 * The Article shell self-determines locale.
 */
import CopyButton from '@/components/ui/CopyButton.astro';
import ArticleShell from '@/components/content/ArticleShell.astro';
import { GITHUB_URL, PRIMARY_INSTALL_COMMAND } from '@/config/site';
import { localizedHref, localeFromUrl } from '@/i18n/config';
import { useLocalizer, useMessages } from '@/i18n/t';

const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
const m = useMessages(locale);
const hub = m.alt.hub;
const title = t('meta.alt.hub.title');
const description = t('meta.alt.hub.description');
---

<ArticleShell
  title={title}
  description={description}
  datePublished="2026-08-01"
  about={['aic', 'AI commit message tools', 'alternatives']}
  crumbs={[
    { name: t('contentHeader.home'), path: '' },
    { name: hub.eyebrow, path: '' },
  ]}
>
  <p class="eyebrow"><span class="line" aria-hidden="true"></span>{hub.eyebrow}</p>
  <h1>{hub.h1}</h1>
  <p class="lede" set:html={hub.lede} />

  <section class="block">
    <h2>{hub.h2}</h2>
    <ul class="cards">
      {
        hub.items.map((item) => (
          <li class="card">
            <a class="card-link" href={localizedHref(locale, `alternatives/${item.id}`)}>
              <span class="card-name">{item.name}</span>
              <span class="card-line">{item.line}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="verdict">
    <div class="cta">
      <CopyButton text={PRIMARY_INSTALL_COMMAND} variant="primary" />
      <a class="cta-link" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
        {t('footer.star')}
      </a>
    </div>
  </section>
</ArticleShell>

<style>
  /* Page-unique styles. The article CSS layer (.article namespace) lives in
     ArticleShell. */
  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 640px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
  .card a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--color-line-soft);
    border-radius: 12px;
    background: var(--color-surface);
    text-decoration: none;
    height: 100%;
    transition: border-color var(--duration-fast) ease;
  }
  .card a:hover {
    border-color: var(--color-amber);
  }
  .card-name {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-amber);
    font-size: 0.95rem;
  }
  .card-line {
    color: var(--color-ink-muted);
    line-height: 1.55;
    font-size: 0.92rem;
  }
</style>
