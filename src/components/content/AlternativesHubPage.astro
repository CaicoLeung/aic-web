---
/**
 * /alternatives/ — migration-intent hub (ADR-0006).
 *
 * Ranks aic's alternatives by why each user base might switch, linking to
 * each singular /alternatives/{id} page. Honest by design: it concedes
 * where staying makes sense (each card's one-liner is the switch case).
 *
 * Rendered by both `/alternatives/` and `/[locale]/alternatives/` (ADR-0010).
 */
import { loadAicFacts } from '@/data/aic';
import Base from '@/layouts/Base.astro';
import ContentHeader from '@/components/content/ContentHeader.astro';
import Footer from '@/components/footer/Footer.astro';
import CopyButton from '@/components/ui/CopyButton.astro';
import { GITHUB_URL, PRIMARY_INSTALL_COMMAND, SITE_ORIGIN } from '@/config/site';
import { localizedHref, localeFromUrl } from '@/i18n/config';
import { useLocalizer, useMessages } from '@/i18n/t';
import { articleSchema, breadcrumbSchema, canonicalUrl, type Crumb } from '@/lib/schema';

const facts = await loadAicFacts();
const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
const m = useMessages(locale);
const hub = m.alt.hub;
const title = t('meta.alt.hub.title');
const description = t('meta.alt.hub.description');

// Canonical URL + absolute crumb URLs for Article.url / BreadcrumbList.
const site = Astro.site ?? SITE_ORIGIN;
const canonical = canonicalUrl(Astro.url.pathname, site);
const abs = (slug: string) => canonicalUrl(localizedHref(locale, slug), site);
const crumbs: readonly Crumb[] = [
  { name: t('contentHeader.home'), url: abs('') },
  { name: hub.eyebrow, url: canonical },
];

const schema = [
  articleSchema({
    headline: title,
    description,
    datePublished: '2026-08-01',
    about: ['aic', 'AI commit message tools', 'alternatives'],
    url: canonical,
    site,
  }),
  breadcrumbSchema(crumbs),
];
---

<Base version={facts.version} title={title} description={description} schema={schema}>
  <ContentHeader version={facts.version} />

  <main id="main">
    <article class="article container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={localizedHref(locale, '')}>{t('contentHeader.home')}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{hub.eyebrow}</span>
      </nav>
      <p class="eyebrow"><span class="line" aria-hidden="true"></span>{hub.eyebrow}</p>
      <h1>{hub.h1}</h1>
      <p class="lede" set:html={hub.lede} />

      <section class="block">
        <h2>{hub.h2}</h2>
        <ul class="cards">
          {
            hub.items.map((item) => (
              <li class="card">
                <a
                  class="card-link"
                  href={localizedHref(locale, `alternatives/${item.id}`)}
                >
                  <span class="card-name">{item.name}</span>
                  <span class="card-line">{item.line}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="verdict">
        <div class="cta">
          <CopyButton text={PRIMARY_INSTALL_COMMAND} variant="primary" />
          <a class="cta-link" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
            {t('footer.star')}
          </a>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</Base>

<style>
  .article {
    max-width: 820px;
    padding-block: clamp(2.5rem, 1rem + 4vw, 4.5rem) clamp(3rem, 1rem + 5vw, 5rem);
    position: relative;
    z-index: 2;
  }
  h1 {
    font-size: var(--text-h2);
    line-height: 1.05;
    margin: 0.75rem 0 0;
  }
  .lede {
    color: var(--color-ink-muted);
    line-height: 1.65;
    margin-top: 1rem;
    font-size: var(--text-lede);
  }
  .lede code {
    color: var(--color-amber);
    font-family: var(--font-mono);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-ink-dim);
    margin-bottom: 0.5rem;
  }
  .crumbs a {
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--color-amber);
  }
  .crumbs span[aria-current='page'] {
    color: var(--color-ink);
  }

  .block {
    margin-top: 2.75rem;
  }
  .block h2 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
  }

  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 640px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
  .card a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--color-line-soft);
    border-radius: 12px;
    background: var(--color-surface);
    text-decoration: none;
    height: 100%;
    transition: border-color var(--duration-fast) ease;
  }
  .card a:hover {
    border-color: var(--color-amber);
  }
  .card-name {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-amber);
    font-size: 0.95rem;
  }
  .card-line {
    color: var(--color-ink-muted);
    line-height: 1.55;
    font-size: 0.92rem;
  }

  .verdict {
    margin-top: 2.75rem;
    padding: 1.75rem;
    border: 1px solid var(--color-line-soft);
    border-radius: 14px;
    background: var(--color-surface);
  }
  .cta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .cta-link {
    color: var(--color-ink);
    text-decoration: none;
    padding: 0.55rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    transition:
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }
  .cta-link:hover {
    border-color: var(--color-amber);
    color: var(--color-amber);
  }
</style>
