---
/**
 * Animated terminal mockup — the batching story, live.
 *
 * Narrative: type `aic` → spinner reads the unstaged hunks → reasoning
 * streams in per hunk (`@@N → intent`) → condenses to a plan line →
 * commits ship in sequence. Loops. Static final state is visible
 * without JS / under reduced-motion.
 *
 * Data reuses the `HUNK_SPLITTING` constant so the hero and #03 tell the
 * same story (process here, result there). `aria-hidden` because the same
 * information is in the hero copy — decorative reinforcement.
 *
 * Built on the shared ui/TerminalShell chrome (same idiom as
 * resolve/ResolveTerminal.astro): TerminalShell owns the window frame and
 * the monospace primitives (`.row` / `.prompt` / `.cmdin` / `.out` / `.ok` /
 * `.spin`); this file owns only the batching body and its GSAP timeline.
 */
import TerminalShell from '@/components/ui/TerminalShell.astro';
import { HUNK_SPLITTING, HUNK_TYPE_ACCENT } from '@/config/site';
import HunkTraceLine from '@/components/batching/HunkTraceLine.astro';

interface Props {
  /** Wire chrome variant — the hero passes 'wire' to fuse the terminal into
   *  the DAG line-art language (Q9). Default (unset) keeps solid chrome. */
  readonly variant?: 'wire';
  /** Auto-play the demo loop on load (default true). The HeroStorm popup
   *  terminal passes `false` so it stays paused until the user opens the
   *  modal, then replays fresh on the `term:replay` event. */
  readonly autoPlay?: boolean;
}
const { variant, autoPlay = true } = Astro.props;

const hunks = HUNK_SPLITTING.hunks;
const commits = HUNK_SPLITTING.commits;
---

<TerminalShell variant={variant} autoPlay={autoPlay}>
  <div class="row" data-row="cmd">
    <span class="prompt">$</span>
    <span class="cmdin" data-typed>aic</span>
  </div>
  <div class="row" data-row="spinner">
    <span class="spin" aria-hidden="true">⠋</span>
    <span class="out">reading {hunks.length} unstaged hunks…</span>
  </div>

  <div class="reasoning" data-reasoning>
    <div class="re-head">reasoning · per hunk</div>
    {hunks.map((h) => <HunkTraceLine h={h} />)}
  </div>

  <div class="planline" data-plan>
    <span class="plan-icon" aria-hidden="true">✦</span>
    <span class="plan-text">plan · {commits.length} commits</span>
  </div>

  <div class="commits" data-commits>
    {
      commits.map((c) => (
        <div class="row commitrow" data-commit>
          <svg
            class="ok"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5" />
          </svg>
          <span class="hash">{c.hash}</span>
          <span class="msg">
            <span class="ctype" style={`--accent: ${HUNK_TYPE_ACCENT[c.type]}`}>
              {c.type}
            </span>
            <span class="scope">({c.scope})</span>
            <span class="summary">: {c.summary}</span>
          </span>
        </div>
      ))
    }
  </div>
</TerminalShell>

<style>
  /* Body-specific styles. Chrome (.terminal / .termbar / .termbody) and the
     shared mono primitives (.row / .prompt / .cmdin / .out / .ok / .spin)
     live in ui/TerminalShell.astro. */

  /* ── Reasoning block: terse hunk → intent trace ──────────────────── */
  .reasoning {
    margin: 0.6rem 0 0.5rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--color-line-soft);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.015);
  }
  .re-head {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-dim);
    margin-bottom: 0.3rem;
  }

  /* ── Plan line: the pivot from thinking to shipping ──────────────── */
  .planline {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0.5rem 0 0.55rem;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--color-line-soft);
    color: var(--color-amber);
    font-weight: 600;
    font-size: 0.82rem;
  }
  .plan-icon {
    color: var(--color-amber);
  }

  /* Wire variant (hero fusion, Q9): rhyme the reasoning box + plan divider
     with the DAG's amber-tint edges so the terminal body speaks the same
     line-art idiom as the background graph. `.terminal.wire` is authored on
     the shared TerminalShell figure; only the hero passes the variant. */
  .terminal.wire .reasoning {
    border-color: color-mix(in oklch, var(--color-amber) 22%, transparent);
    background: color-mix(in oklch, var(--color-amber) 5%, transparent);
  }
  .terminal.wire .planline {
    border-top-color: color-mix(in oklch, var(--color-amber) 24%, transparent);
  }

  /* ── Commits ─────────────────────────────────────────────────────── */
  .commits {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .commitrow {
    align-items: flex-start;
  }
  .commitrow .ok {
    flex: none;
    width: 0.9em;
    height: 0.9em;
    /* Center the icon on the first text line's optical mid (line-height
     * 1.7 → half-leading + half-icon). Keeps it aligned with the hash /
     * first msg line, not the middle of a wrapped block. */
    margin-top: 0.4em;
  }
  .commitrow .hash {
    color: var(--color-amber);
    font-weight: 600;
    flex-shrink: 0;
  }
  .commitrow .msg {
    color: var(--color-ink);
    white-space: normal;
  }
  .commitrow .ctype {
    color: var(--accent, var(--color-amber));
    font-weight: 600;
  }
  .commitrow .scope {
    color: var(--color-ink-muted);
  }
  .commitrow .summary {
    color: var(--color-ink);
  }

  /* Reduced-motion / no-JS default: everything visible. */
  :global([data-term-body]) .row,
  :global([data-term-body]) .reasoning,
  :global([data-term-body]) .planline,
  :global([data-term-body]) .commits,
  :global([data-term-body]) .commitrow {
    opacity: 1;
  }
</style>

<script>
  import { gsap, whenMotionOk, whileVisible } from '@/lib/motion';

  whenMotionOk(() => {
    const terms = document.querySelectorAll<HTMLElement>('[data-term-body]');

    // Teardown for each terminal's visibility observer — returned below so
    // whenMotionOk reverts them with the rest of the motion context.
    const reverts: Array<() => void> = [];

    terms.forEach((term) => {
      const typed = term.querySelector<HTMLElement>('[data-typed]');
      const spinner = term.querySelector<HTMLElement>('[data-row="spinner"]');
      const spinGlyph = spinner?.querySelector<HTMLElement>('.spin');
      const reasoning = term.querySelector<HTMLElement>('[data-reasoning]');
      const reLines = term.querySelectorAll<HTMLElement>('[data-hunk-line]');
      const plan = term.querySelector<HTMLElement>('[data-plan]');
      const commitRows = term.querySelectorAll<HTMLElement>('[data-commit]');
      if (
        !typed ||
        !spinner ||
        !spinGlyph ||
        !reasoning ||
        !plan ||
        commitRows.length === 0
      )
        return;

      // The hero DAG listens for `term:commit` / `term:reset` bubbling off the
      // terminal figure (Q3 fusion + Q4 trace binding).
      const termRoot = term.closest('.terminal');
      // autoPlay comes from the figure's data-autoplay (set from the prop) —
      // the client script can't see frontmatter, so read it from the DOM.
      const autoPlay = termRoot?.dataset.autoplay !== 'false';

      const fullText = typed.textContent ?? 'aic';

      const spinnerFrames = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏'];
      let frame = 0;

      // Glyph cycle — paused except while the spinner row is visible.
      const spinnerCycle = gsap.to(
        {},
        {
          duration: 0.08,
          repeat: -1,
          paused: true,
          onRepeat: () => {
            frame = (frame + 1) % spinnerFrames.length;
            spinGlyph.textContent = spinnerFrames[frame];
          },
        },
      );

      const tl = gsap.timeline({
        delay: 0.5,
        repeat: -1,
        repeatDelay: 3.2,
        // Always start paused; the IntersectionObserver below (Q6-B) drives
        // play for the autoPlay variant only while on-screen, and the popup
        // replay event drives the non-autoPlay variant.
        paused: true,
        onReverseComplete: () => spinnerCycle.pause(),
      });

      // Tell the hero DAG (Q4 fusion) to reset its lit path each loop.
      tl.call(() =>
        termRoot?.dispatchEvent(new CustomEvent('term:reset', { bubbles: true })),
      );

      // Let the HeroStorm popup replay (open) or pause (close) this terminal.
      term.addEventListener('term:replay', () => tl.restart());
      term.addEventListener('term:pause', () => tl.pause());

      // Q6-B: pause the loop when the terminal is off-screen, resume in view.
      // Only autoPlay terminals self-run — the popup variant is driven by its
      // open/close events and must not be auto-played by visibility.
      // whileVisible owns the observer + its teardown (captured into `reverts`
      // below), so it reverts cleanly on hot-reload / reduced-motion toggles.
      if (autoPlay) {
        reverts.push(
          whileVisible(
            term,
            () => tl.play(),
            () => {
              tl.pause();
              spinnerCycle.pause();
            },
          ),
        );
      }

      // Reset to the pre-animation state at the start of every loop so the
      // replay reads cleanly (typed emptied, downstream hidden).
      tl.set(typed, { opacity: 1 });
      tl.set(
        [spinner, reasoning, ...Array.from(reLines), plan, ...Array.from(commitRows)],
        { opacity: 0 },
      );
      tl.set(reLines, { x: -8 });
      tl.set(plan, { y: 6 });
      tl.set(commitRows, { x: 6 });

      // 1. Type "aic".
      tl.to(
        {},
        {
          duration: 0.45,
          onUpdate: function () {
            const progress = this.progress();
            typed.textContent = fullText.slice(0, Math.ceil(fullText.length * progress));
          },
        },
      );

      // 2. Spinner: read the hunks. Glyph cycles while visible.
      tl.call(() => {
        frame = 0;
        spinGlyph.textContent = spinnerFrames[0];
        spinnerCycle.restart();
      });
      tl.to(spinner, { opacity: 1, duration: 0.18 });
      tl.to(spinner, { opacity: 0, duration: 0.2, delay: 0.75 });
      tl.call(() => spinnerCycle.pause());

      // 3. Reasoning block container, then lines stream in one-by-one.
      tl.to(reasoning, { opacity: 1, duration: 0.2 });
      tl.to(reLines, {
        opacity: 1,
        x: 0,
        duration: 0.3,
        stagger: 0.16,
        ease: 'power2.out',
      });

      // 4. Plan line — the pivot.
      tl.to(plan, { opacity: 1, y: 0, duration: 0.35, ease: 'power2.out' }, '+=0.12');

      // 5. Commits ship, in sequence — each fires `term:commit` so the hero DAG
      // traces the matching node in sync (Q4). The `commits` label + per-row
      // positions reproduce the original 0.22 stagger cadence exactly.
      tl.addLabel('commits');
      commitRows.forEach((row, i) => {
        const at = `commits+=${(i * 0.22).toFixed(3)}`;
        tl.to(row, { opacity: 1, x: 0, duration: 0.3, ease: 'power2.out' }, at);
        tl.call(
          () =>
            termRoot?.dispatchEvent(
              new CustomEvent('term:commit', {
                detail: { index: i },
                bubbles: true,
              }),
            ),
          null,
          at,
        );
      });
    });

    // Revert every terminal's visibility observer alongside the GSAP
    // timelines, which whenMotionOk already auto-reverts.
    return () => reverts.forEach((revert) => revert());
  });
</script>
