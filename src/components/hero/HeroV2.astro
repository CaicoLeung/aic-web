---
/**
 * HeroV2 — "The Diff Lab"
 *
 * A scroll-driven product showcase: a real code editor showing a mixed-concern
 * diff that aic decomposes into focused commits. As you scroll:
 *   1. Raw diff hunks light up with group colors (aic analyzes)
 *   2. SVG curves draw from hunks to commit cards (aic groups)
 *   3. Commit cards emerge with conventional messages
 *   4. Terminal shows the command + result
 *
 * Progressive enhancement:
 *   - No JS → final state (everything visible)
 *   - JS + motion → scroll-driven reveal
 */
---

<section class="hero-lab" id="top" data-hero-lab>
  <div class="lab-pin">
    <div class="lab-stage" data-lab-stage>
      <!-- ═══ LEFT: Code editor ═══ -->
      <div class="editor" data-editor>
        <div class="ed-chrome">
          <div class="ed-dots">
            <span></span><span></span><span></span>
          </div>
          <div class="ed-tabs">
            <span class="ed-tab active">auth.ts</span>
            <span class="ed-tab dim">package.json</span>
          </div>
          <span class="ed-stat">+12 −1</span>
        </div>
        <div class="ed-body" data-ed-body>
          <!-- AMBER group: session refactor -->
          <div class="hunk" data-hunk data-group="1" style="--gc: var(--color-amber)">
            <div class="hunk-glow" data-hunk-glow></div>
            <div class="hunk-line" data-i="0">
              <span class="ln">3</span><span class="sign del">-</span><span class="code"
                ><span class="kw">const</span> session = getStoredSession()</span
              >
            </div>
            <div class="hunk-line" data-i="0">
              <span class="ln">4</span><span class="sign add">+</span><span class="code"
                ><span class="kw">const</span> session = <span class="kw">await</span>
                <span class="fn">refreshToken</span>(stored)</span
              >
            </div>
          </div>

          <div class="hunk-gap"></div>

          <!-- CYAN group: new refresh function -->
          <div class="hunk" data-hunk data-group="0" style="--gc: var(--color-cyan)">
            <div class="hunk-glow" data-hunk-glow></div>
            <div class="hunk-line" data-i="0">
              <span class="ln">6</span><span class="sign add">+</span><span class="code"
                ><span class="kw">export async function</span>
                <span class="fn">refreshToken</span>(t: <span class="ty">string</span>)
                &#123;</span
              >
            </div>
            <div class="hunk-line" data-i="1">
              <span class="ln">7</span><span class="sign add">+</span><span class="code"
                ><span class="kw">const</span> res = <span class="kw">await</span>
                <span class="fn">fetch</span>(&#123;</span
              >
            </div>
            <div class="hunk-line" data-i="2">
              <span class="ln">8</span><span class="sign add">+</span><span class="code"
                >url: <span class="str">'/api/refresh'</span>,</span
              >
            </div>
            <div class="hunk-line" data-i="2">
              <span class="ln">9</span><span class="sign add">+</span><span class="code"
                >method: <span class="str">'POST'</span>,</span
              >
            </div>
            <div class="hunk-line" data-i="2">
              <span class="ln">10</span><span class="sign add">+</span><span class="code"
                >body: <span class="fn">JSON</span>.<span class="fn">stringify</span
                >(&#123; t &#125;),</span
              >
            </div>
            <div class="hunk-line" data-i="1">
              <span class="ln">11</span><span class="sign add">+</span><span class="code"
                >&#125;)</span
              >
            </div>
            <div class="hunk-line" data-i="1">
              <span class="ln">12</span><span class="sign add">+</span><span class="code"
                ><span class="kw">return</span> res.<span class="fn">json</span>()</span
              >
            </div>
            <div class="hunk-line" data-i="0">
              <span class="ln">13</span><span class="sign add">+</span><span class="code"
                >&#125;</span
              >
            </div>
          </div>

          <div class="hunk-gap"></div>

          <!-- AMBER group continued: session redirect -->
          <div class="hunk" data-hunk data-group="1" style="--gc: var(--color-amber)">
            <div class="hunk-glow" data-hunk-glow></div>
            <div class="hunk-line" data-i="0">
              <span class="ln">15</span><span class="sign add">+</span><span class="code"
                ><span class="kw">if</span> (session.expired) &#123;</span
              >
            </div>
            <div class="hunk-line" data-i="1">
              <span class="ln">16</span><span class="sign add">+</span><span class="code"
                ><span class="kw">return</span>
                <span class="fn">redirect</span>(<span class="str"
                  >'/login?reason=expired'</span
                >)</span
              >
            </div>
            <div class="hunk-line" data-i="0">
              <span class="ln">17</span><span class="sign add">+</span><span class="code"
                >&#125;</span
              >
            </div>
          </div>
          <div class="hunk-gap"></div>
          <!-- MINT group: dependency bump (package.json) -->
          <div class="hunk-file">package.json</div>
          <div class="hunk" data-hunk data-group="2" style="--gc: var(--color-mint)">
            <div class="hunk-glow" data-hunk-glow></div>
            <div class="hunk-line" data-i="1">
              <span class="ln">19</span><span class="sign add">+</span><span class="code"
                ><span class="str">"next"</span>: <span class="str">"^14.2.0"</span></span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- ═══ CENTER: SVG curves ═══ -->
      <svg class="curves" data-curves preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="curve-0" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="var(--color-cyan)" stop-opacity="0.6"></stop>
            <stop offset="100%" stop-color="var(--color-cyan)" stop-opacity="0.2"></stop>
          </linearGradient>
          <linearGradient id="curve-1" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="var(--color-amber)" stop-opacity="0.6"></stop>
            <stop offset="100%" stop-color="var(--color-amber)" stop-opacity="0.2"></stop>
          </linearGradient>
          <linearGradient id="curve-2" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="var(--color-mint)" stop-opacity="0.6"></stop>
            <stop offset="100%" stop-color="var(--color-mint)" stop-opacity="0.2"></stop>
          </linearGradient>
        </defs>
        <path class="curve" data-curve data-group="0" stroke="url(#curve-0)"></path>
        <path class="curve" data-curve data-group="1" stroke="url(#curve-1)"></path>
        <path class="curve" data-curve data-group="2" stroke="url(#curve-2)"></path>
      </svg>

      <!-- ═══ RIGHT: Commit cards ═══ -->
      <div class="commits" data-commits>
        <div
          class="commit-card"
          data-commit-card
          data-group="0"
          style="--gc: var(--color-cyan)"
        >
          <div class="cc-bar"></div>
          <div class="cc-dot"></div>
          <div class="cc-body">
            <div class="cc-head">
              <span class="cc-type">feat</span>
              <span class="cc-scope">auth</span>
            </div>
            <div class="cc-msg">add token refresh endpoint</div>
            <div class="cc-meta">
              <span class="cc-hash">a4f2c81</span>
              <span class="cc-files">1 file</span>
            </div>
          </div>
        </div>

        <div
          class="commit-card"
          data-commit-card
          data-group="1"
          style="--gc: var(--color-amber)"
        >
          <div class="cc-bar"></div>
          <div class="cc-dot"></div>
          <div class="cc-body">
            <div class="cc-head">
              <span class="cc-type">fix</span>
              <span class="cc-scope">ui</span>
            </div>
            <div class="cc-msg">redirect on session expiry</div>
            <div class="cc-meta">
              <span class="cc-hash">b7e9d03</span>
              <span class="cc-files">1 file</span>
            </div>
          </div>
        </div>

        <div
          class="commit-card"
          data-commit-card
          data-group="2"
          style="--gc: var(--color-mint)"
        >
          <div class="cc-bar"></div>
          <div class="cc-dot"></div>
          <div class="cc-body">
            <div class="cc-head">
              <span class="cc-type">chore</span>
              <span class="cc-scope">deps</span>
            </div>
            <div class="cc-msg">bump next to 14.2.0</div>
            <div class="cc-meta">
              <span class="cc-hash">c3a1f57</span>
              <span class="cc-files">package.json</span>
            </div>
          </div>
        </div>
      </div>
    </div><!-- /lab-stage -->

    <!-- ═══ BOTTOM: Terminal bar ═══ -->
    <div class="lab-term" data-lab-term>
      <div class="term-line">
        <span class="term-prompt">$</span>
        <span class="term-cmd">aic commit --all</span>
        <span class="term-cursor" data-term-cursor>▋</span>
      </div>
      <div class="term-result" data-term-result>
        <span class="tr-ok">✓</span> 3 commits created in <b>4.2s</b> — <span
          class="tr-link">view on GitHub →</span
        >
      </div>
    </div>
    <span class="lab-hint" data-lab-hint>scroll to decompose ↓</span>
  </div><!-- /lab-pin -->
</section>

<style>
  /* ═══ Section: scroll track ═══════════════════════════════════════ */
  .hero-lab {
    height: 160vh;
    position: relative;
    background: var(--color-base-deep);
  }

  .lab-pin {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    overflow: hidden;
  }
  @media (min-width: 769px) {
    /* Desktop stage content is ~57vh; a shorter pin trims the post-reveal
       exit so the next section arrives sooner. Mobile keeps 100vh (content
       stacks to ~80vh and would clip). */
    .lab-pin {
      height: 76vh;
    }
  }

  /* ═══ Scroll hint ══════════════════════════════════════════════════ */
  .lab-hint {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-secondary, #8b8d98);
    opacity: 0.5;
    transition: opacity 0.3s;
    white-space: nowrap;
  }

  /* ═══ Stage: split layout ═════════════════════════════════════════ */
  .lab-stage {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
    padding: 0 clamp(1rem, 4vw, 3rem);
    position: relative;
    max-width: 1040px;
    margin: 0 auto;
    width: 100%;
  }

  /* ═══ Editor ══════════════════════════════════════════════════════ */
  .editor {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 10px;
    overflow: hidden;
    max-width: 620px;
    box-shadow:
      0 1px 0 0 rgba(255, 255, 255, 0.03) inset,
      0 20px 60px -20px rgba(0, 0, 0, 0.5);
  }
  .ed-chrome {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid var(--color-line-soft);
    background: var(--color-surface-raised);
  }
  .ed-dots {
    display: flex;
    gap: 6px;
  }
  .ed-dots span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-line);
  }
  .ed-dots span:nth-child(1) {
    background: var(--dot-close);
  }
  .ed-dots span:nth-child(2) {
    background: var(--dot-min);
  }
  .ed-dots span:nth-child(3) {
    background: var(--dot-max);
  }
  .ed-tabs {
    display: flex;
    gap: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .ed-tab {
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    color: var(--color-text-secondary, #8b8d98);
  }
  .ed-tab.active {
    background: color-mix(in oklch, var(--color-cyan) 8%, transparent);
    color: var(--color-cyan);
  }
  .ed-tab.dim {
    opacity: 0.4;
  }
  .ed-stat {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-faint, #6b6c74);
  }
  .ed-body {
    padding: 0.75rem 0;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.7;
    max-height: 56vh;
    overflow: hidden;
  }

  /* ═══ Hunk groups ═════════════════════════════════════════════════ */
  .hunk {
    position: relative;
    padding: 0.15rem 0;
  }
  .hunk-gap {
    height: 0.6rem;
  }
  .hunk-glow {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--gc);
    border-radius: 0 2px 2px 0;
    opacity: 0.9;
    will-change: opacity;
  }
  .hunk-file {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-faint, #6b6c74);
    padding: 0.2rem 0 0.1rem 0.6rem;
    border-top: 1px solid var(--color-line-soft);
    margin-top: 0.3rem;
  }
  .hunk-line {
    display: flex;
    padding-left: 0.6rem;
  }
  .ln {
    display: inline-block;
    width: 1.8rem;
    text-align: right;
    padding-right: 0.7rem;
    color: var(--color-text-faint, #4a4c58);
    user-select: none;
    flex-shrink: 0;
  }
  .sign {
    width: 1ch;
    flex-shrink: 0;
    font-weight: 700;
  }
  .sign.add {
    color: #b8d5a0;
  }
  .sign.del {
    color: #d59090;
  }
  .code {
    color: var(--color-ink);
  }
  .hunk-line[data-i='1'] .code {
    margin-left: 2ch;
  }
  .hunk-line[data-i='2'] .code {
    margin-left: 4ch;
  }
  .kw {
    color: #c792ea;
  }
  .fn {
    color: var(--color-cyan);
  }
  .ty {
    color: var(--color-amber);
  }
  .str {
    color: #c3e88d;
  }

  /* ═══ SVG curves ══════════════════════════════════════════════════ */
  .curves {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
    overflow: visible;
  }
  .curve {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.7;
    will-change: stroke-dashoffset, opacity;
  }

  /* ═══ Commit cards ════════════════════════════════════════════════ */
  .commits {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-left: 1rem;
    z-index: 1;
  }
  .commit-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.65rem 0.9rem 0.65rem 1.1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 8px;
    max-width: 280px;
    opacity: 1;
    will-change: transform, opacity;
    box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.4);
  }
  .cc-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--gc);
    border-radius: 8px 0 0 8px;
  }
  .cc-dot {
    position: absolute;
    left: -5px;
    top: 50%;
    transform: translateY(-50%);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--gc);
    border: 2px solid var(--color-base-deep);
    flex-shrink: 0;
  }
  .cc-body {
    flex: 1;
  }
  .cc-head {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.15rem;
  }
  .cc-type {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--gc);
  }
  .cc-scope {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-secondary, #8b8d98);
  }
  .cc-msg {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-ink);
    line-height: 1.3;
  }
  .cc-meta {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--color-text-faint, #6b6c74);
  }

  /* ═══ Terminal bar ═════════════════════════════════════════════════ */
  .lab-term {
    padding: 0.8rem 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    opacity: 1;
    will-change: opacity;
  }
  .term-line {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .term-prompt {
    color: var(--color-cyan);
  }
  .term-cmd {
    color: var(--color-ink);
  }
  .term-cursor {
    color: var(--color-cyan);
  }
  @media (prefers-reduced-motion: no-preference) {
    .term-cursor {
      animation: term-blink 1s steps(2) infinite;
    }
  }
  @keyframes term-blink {
    50% {
      opacity: 0;
    }
  }
  .term-result {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-secondary, #8b8d98);
  }
  .tr-ok {
    color: var(--color-mint);
  }
  .tr-link {
    color: var(--color-cyan);
  }

  /* ═══ Mobile ═══════════════════════════════════════════════════════ */
  @media (max-width: 768px) {
    .lab-stage {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .curves {
      display: none;
    }
    .commits {
      padding-left: 0;
    }
    .commit-card {
      max-width: none;
    }
    .ed-body {
      font-size: 0.68rem;
    }
  }

  /* ── Progressive enhancement ──
     Reveal targets default to their final state. Hide them only when JS
     is on and motion is allowed — GSAP then drives the scroll reveal.
     No-JS + prefers-reduced-motion see the finished hero. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-lab[data-js] .hunk-glow {
      opacity: 0;
    }
    .hero-lab[data-js] .curve {
      opacity: 0;
    }
    .hero-lab[data-js] .commit-card {
      opacity: 0;
      transform: translateX(16px);
    }
    .hero-lab[data-js] .lab-term {
      opacity: 0;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, whenMotionOk } from '@/lib/motion';

  document.querySelector('[data-hero-lab]')?.setAttribute('data-js', '');

  whenMotionOk(() => {
    const section = document.querySelector<HTMLElement>('[data-hero-lab]');
    if (!section) return;

    const stage = section.querySelector<HTMLElement>('[data-lab-stage]');
    const editor = section.querySelector<HTMLElement>('[data-editor]');
    const hunks = gsap.utils.toArray<HTMLElement>('[data-hunk]');
    const glows = gsap.utils.toArray<HTMLElement>('[data-hunk-glow]');
    const curves = gsap.utils.toArray<SVGPathElement>('[data-curve]');
    const cards = gsap.utils.toArray<HTMLElement>('[data-commit-card]');
    const term = section.querySelector<HTMLElement>('[data-lab-term]');
    const hint = section.querySelector<HTMLElement>('[data-lab-hint]');
    const pin = section.querySelector<HTMLElement>('.lab-pin');
    if (!stage || !editor || !pin) return;

    // ── Initial states ──────────────────────────────────────────────
    gsap.set(glows, { opacity: 0 });
    gsap.set(curves, { opacity: 0 });
    gsap.set(cards, { opacity: 0, x: 16 });
    gsap.set(term, { opacity: 0 });

    // ── Compute SVG curve paths (hunk → commit card) ────────────────
    const svgEl = stage!.querySelector<SVGSVGElement>('[data-curves]')!;
    function buildCurves() {
      const sw = stage!.offsetWidth;
      const sh = stage!.offsetHeight;
      svgEl.setAttribute('width', String(sw));
      svgEl.setAttribute('height', String(sh));
      svgEl.setAttribute('viewBox', `0 0 ${sw} ${sh}`);

      const stageRect = stage!.getBoundingClientRect();
      curves.forEach((curve) => {
        const gi = curve.dataset.group;
        const hunk = hunks.find((h) => h.dataset.group === gi);
        const card = cards.find((c) => c.dataset.group === gi);
        if (!hunk || !card) return;

        const hr = hunk.getBoundingClientRect();
        const cr = card.getBoundingClientRect();

        const x1 = hr.right - stageRect.left;
        const y1 = hr.top + hr.height / 2 - stageRect.top;
        const x2 = cr.left - stageRect.left;
        const y2 = cr.top + cr.height / 2 - stageRect.top;

        const midX = (x1 + x2) / 2;
        curve.setAttribute(
          'd',
          `M ${x1} ${y1} C ${midX} ${y1}, ${midX} ${y2}, ${x2} ${y2}`,
        );

        const len = curve.getTotalLength();
        gsap.set(curve, { strokeDasharray: len, strokeDashoffset: len });
      });
    }

    // Build after layout settles
    requestAnimationFrame(() => requestAnimationFrame(buildCurves));

    // ── Scroll timeline (spans the pin's sticky range; padded 0.5, ~96%) ─
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: () => `+=${section.offsetHeight - pin!.offsetHeight}`,
        scrub: 0.6,
        onRefresh: buildCurves,
      },
    });

    // Phase 1: hunks light up
    tl.to(
      glows,
      {
        opacity: 0.9,
        stagger: 0.03,
        duration: 0.1,
        ease: 'power1.inOut',
      },
      0.03,
    );

    tl.to(hint, { opacity: 0, duration: 0.05 }, 0.02);

    // Phase 2: curves draw
    tl.to(
      curves,
      {
        opacity: 0.7,
        duration: 0.04,
        stagger: 0.03,
      },
      0.15,
    );

    tl.to(
      curves,
      {
        strokeDashoffset: 0,
        duration: 0.15,
        stagger: 0.03,
        ease: 'power1.inOut',
      },
      0.15,
    );

    // Phase 3: commit cards slide in
    tl.to(
      cards,
      {
        opacity: 1,
        x: 0,
        duration: 0.1,
        stagger: 0.04,
        ease: 'power2.out',
      },
      0.25,
    );

    // Phase 4: terminal appears
    tl.to(
      term,
      {
        opacity: 1,
        duration: 0.1,
        ease: 'power2.out',
      },
      0.38,
    );

    // Pad timeline to 0.5 — animation fills ~96% of the pin range, so there's
    // no dead tail; a tiny settle, then the stage unpins.
    tl.set({}, {}, 0.5);

    // ── Resize: rebuild curves ──────────────────────────────────────
    let resizeTimer: ReturnType<typeof setTimeout>;
    const onResize = () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(buildCurves, 150);
    };
    window.addEventListener('resize', onResize);
    return () => window.removeEventListener('resize', onResize);
  });
</script>
