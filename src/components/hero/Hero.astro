---
/**
 * Hero — a commit graph that writes itself.
 *
 * Concept (redesign consensus, 13 decisions): a full-bleed git commit
 * graph (DAG) is the hero's signature. The terminal — restyled to a
 * wireframe idiom — is the stable causal anchor; as it ships commits
 * (feat → fix → refactor), each one trace-draws onto the graph's tip in
 * sync, like new history being appended to the repo. The H1 sits static
 * as the reader's anchor; the only motion is the graph breathing in
 * depth (pointer parallax) and receding on scroll.
 *
 * Minimalism discipline: one accent (amber) lights the new commits'
 * edges; the committed nodes use mint (the site's existing success
 * color, rhyming with the terminal's ✓). Existing history is faint
 * ink-dim — neutral structure, not a second accent. Lots of air.
 *
 * Reduced-motion / no-JS: the DAG defaults to its pre-lit final state
 * (full graph drawn, 3 commits lit) in CSS; the motion script reverses
 * it to a hidden pre-trace state and re-traces on the terminal's
 * `term:commit` events, under whenMotionOk only. Every [data-reveal]
 * element defaults to opacity 1, so a no-JS visitor sees the assembled
 * hero. The entrance fade is opacity-only (no translate) to stay
 * coordinated with the static H1.
 *
 * Composition is authored (Dag.astro owns fixed node coordinates). Copy
 * + i18n + composables (CommandsTable / Terminal / CopyButton) are
 * unchanged — only the visual chrome and the motion layer were rebuilt.
 */
import CommandsTable from './CommandsTable.astro';
import Terminal from './Terminal.astro';
import Dag from './Dag.astro';
import CopyButton from '@/components/ui/CopyButton.astro';
import { GITHUB_URL, PRIMARY_INSTALL_COMMAND } from '@/config/site';
import { localizedHref, localeFromUrl } from '@/i18n/config';
import { useLocalizer } from '@/i18n/t';

interface Props {
  readonly stars?: number;
}
const { stars } = Astro.props;

const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
const resolveUrl = localizedHref(locale, 'resolve');
---

<section class="hero" id="top">
  <!-- Signature background: a full-bleed git commit graph (DAG). The hero
       terminal's commits trace-draw onto its tip (Q3 fusion). aria-hidden:
       decorative reinforcement of the hero copy, never primary content. -->
  <Dag />

  <div class="hero-grid container">
    <p class="eyebrow hero-eyebrow" data-reveal>
      <span class="line" aria-hidden="true"></span>{t('hero.eyebrow')}
    </p>

    <h1 class="hero-h1">
      <span class="kin-line">
        <span class="kin-inner">
          {t('hero.h1.stopWriting')}{' '}
          <em class="ital">{t('hero.h1.commit')}</em>{' '}
          <span class="pop">{t('hero.h1.messages')}</span>
        </span>
      </span>
      <span class="kin-line">
        <span class="kin-inner">
          {t('hero.h1.stopUntangling')}{' '}
          <em class="ital">{t('hero.h1.merge')}</em>{' '}
          <span class="pop">{t('hero.h1.conflicts')}</span>
        </span>
      </span>
    </h1>

    <div class="hero-terminal" data-reveal>
      <Terminal variant="wire" />
    </div>

    <p class="lede hero-lede" data-reveal>
      <Fragment set:html={t('hero.ledeBefore')} /><a href={resolveUrl}
        >{t('hero.ledeLink')}</a
      ><Fragment set:html={t('hero.ledeAfter')} />
    </p>

    <div class="hero-actions">
      {
        stars !== undefined && (
          <p class="hero-trust" data-reveal>
            {t('hero.trust', { stars })}
          </p>
        )
      }

      <div class="hero-cta" data-reveal>
        <div class="cta-stack">
          <span class="cta-label">{t('hero.ctaLabel')}</span>
          <CopyButton text={PRIMARY_INSTALL_COMMAND} variant="primary" />
          <span class="cta-hint">
            <span class="arrow" aria-hidden="true">→</span>
            <Fragment set:html={t('hero.ctaHint', { cmd: 'aic setup' })} />
          </span>
        </div>
        <a
          class="cta-link hero-star"
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t('footer.star')}
        </a>
        <p class="platform-note">{t('hero.platformNote')}</p>
      </div>
    </div>

    <div class="hero-commands" data-reveal>
      <CommandsTable />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 2;
    /* Capped so the CTA stays above the fold on common laptop screens.
       Content beyond this simply extends the section. */
    min-height: clamp(560px, 78vh, 800px);
    padding: clamp(2.5rem, 1rem + 4vw, 4.5rem) 0 clamp(2.5rem, 1rem + 4vw, 4.5rem);
    overflow: hidden;
    /* Parallax bus: the rAF loop writes --mx/--my (pointer, -1..1) and --sy
       (scroll-out, 0..1) here; the DAG layers (data-depth <g> in <Dag/>)
       consume them via their per-layer translate. */
    --mx: 0;
    --my: 0;
    --sy: 0;
  }

  /* ── Content grid ──────────────────────────────────────────────── */
  .hero-grid {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .hero-terminal {
    margin-block: 0.75rem;
    display: flex;
    justify-content: center;
  }

  /* Desktop (≥1024): two-column deck — copy + CTA on the left, product
     surface on the right. The right column pairs the terminal with the
     commands reference underneath, so both columns carry comparable
     visual weight. Mobile keeps commands at the end (reference) via DOM
     order.

     Vertical placement: the hero itself is a 3-row grid whose top/bottom
     rows (0.38fr / 0.62fr) split the intra-hero void by the golden ratio,
     so the content block reads from ~38% of the void instead of sitting
     flush at the top — which left a dead band at the bottom on tall
     screens. Symmetric .hero padding acts as the frame; only the void
     inside the frame is split. fr rows collapse to 0 when content exceeds
     the min-height (short screens), so the ratio engages only where a
     void actually exists — the laptop fold guardrail is preserved. */
  @media (min-width: 1024px) {
    .hero {
      display: grid;
      grid-template-rows: 0.38fr auto 0.62fr;
    }
    .hero-grid {
      grid-row: 2;
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      grid-template-areas:
        'eyebrow  terminal'
        'h1       terminal'
        'lede     terminal'
        'actions  commands';
      column-gap: 3.5rem;
      row-gap: 1.4rem;
      align-items: center;
      justify-items: start;
      text-align: left;
    }
    .hero-eyebrow {
      grid-area: eyebrow;
      align-self: end;
      justify-content: flex-start;
    }
    .hero-h1 {
      grid-area: h1;
      font-size: clamp(2.6rem, 1rem + 4.6vw, 4.1rem);
      line-height: 1;
      letter-spacing: -0.04em;
      text-align: left;
      max-width: 14ch;
    }
    .hero-terminal {
      grid-area: terminal;
      order: unset;
      margin-block: 0;
      align-self: center;
      justify-self: center;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    /* Qualified with `.hero` to beat the mobile base rules below
       (`.lede`, `.hero-actions`, `.cta-stack` use single-class selectors
       and sit later in source order, so without the bump their mobile
       centering wins on desktop and skews the left column). */
    .hero .hero-lede {
      grid-area: lede;
      max-width: 34rem;
      text-align: left;
      margin-inline: 0;
    }
    .hero .hero-actions {
      grid-area: actions;
      align-items: flex-start;
      text-align: left;
      gap: 1rem;
    }
    .hero-commands {
      grid-area: commands;
      justify-self: stretch;
      align-self: center;
      margin-top: 0;
      max-width: 100%;
    }
    .hero .hero-cta {
      align-items: flex-start;
      text-align: left;
    }
    .hero .cta-stack {
      align-items: flex-start;
    }
  }

  /* ── Type ──────────────────────────────────────────────────────── */
  h1 {
    font-size: var(--text-hero);
    line-height: 1;
    letter-spacing: -0.035em;
    margin: 0;
    text-align: center;
  }
  h1 .ital {
    font-style: italic;
    font-weight: 700;
    color: var(--color-ink-muted);
  }
  h1 .pop {
    color: var(--color-amber);
  }

  /* H1 line wrappers. Now static (Q10) — the clip-mask reveal was removed;
     the wrappers remain only to preserve italic-descender padding. */
  .kin-line {
    display: block;
    overflow: hidden;
    padding-block: 0.06em 0.12em; /* avoid clipping italic descenders */
  }
  .kin-inner {
    display: block;
  }

  .lede {
    font-size: var(--text-lede);
    color: var(--color-ink-muted);
    line-height: 1.65;
    max-width: 32rem;
    margin: 0;
    text-align: center;
    margin-inline: auto;
  }
  .lede b {
    color: var(--color-ink);
    font-weight: 600;
  }
  .hero-lede a {
    color: var(--color-amber);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklch, var(--color-amber) 40%, transparent);
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }
  .hero-lede a:hover {
    color: var(--color-amber-warm);
    border-bottom-color: var(--color-amber-warm);
  }

  /* ── Actions / CTA ─────────────────────────────────────────────── */
  .hero-trust {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-dim);
    margin: 0;
  }
  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }
  .hero-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .cta-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .cta-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .cta-hint {
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
  }
  .cta-hint .arrow {
    color: var(--color-amber);
  }
  .cta-hint code {
    color: var(--color-amber);
    background: var(--color-amber-soft);
    padding: 3px 8px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.78rem;
  }
  .hero-star {
    border-color: var(--color-amber);
    color: var(--color-amber);
  }
  .hero-star:hover {
    background: var(--color-amber-soft);
  }
  .platform-note {
    font-size: 0.78rem;
    color: var(--color-ink-dim);
    margin: 0.35rem 0 0;
  }
  .hero-terminal :global(.terminal) {
    max-width: 560px;
    font-size: 0.98rem;
  }
  .hero-terminal :global(.termbody) {
    padding: 1.6rem 1.6rem 1.9rem;
    line-height: 1.95;
  }

  /* Reduced-motion / no-JS default: everything in place & visible. */
  [data-reveal] {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  import { gsap, ScrollTrigger, whenMotionOk } from '@/lib/motion';

  whenMotionOk(() => {
    const section = document.querySelector<HTMLElement>('.hero');
    if (!section) return;

    // ── 1. Entrance — opacity-only stagger (Q11). No y-translate, so it
    //      stays coordinated with the static H1 (Q10). The DAG trace-draw
    //      is driven separately by the terminal's `term:commit` events
    //      (see Dag.astro); this script owns only the calm fade-in. ────
    const items = gsap.utils.toArray<HTMLElement>('.hero [data-reveal]');
    if (items.length > 0) {
      gsap.set(items, { opacity: 0 });
      gsap.to(items, {
        opacity: 1,
        duration: 0.6,
        stagger: 0.08,
        ease: 'power2.out',
        delay: 0.12,
      });
    }

    // ── 2. Pointer + scroll parallax bus (lerp-smoothed rAF) ─────────
    // One rAF loop writes the bus vars (--mx/--my pointer -1..1, --sy
    // scroll-out 0..1) on the section. The DAG layers (data-depth <g> in
    // <Dag/>) consume them for depth parallax. The terminal itself stays
    // stable — it is the causal anchor, no tilt (Q8).
    let targetMx = 0;
    let targetMy = 0;
    let curMx = 0;
    let curMy = 0;
    let scrollProg = 0;
    let rafId = 0;

    const noHover =
      typeof window !== 'undefined' &&
      window.matchMedia &&
      window.matchMedia('(hover: none)').matches;

    const onPointer = (e: PointerEvent) => {
      if (noHover) return;
      const rect = section.getBoundingClientRect();
      // Normalise to -1..1 around the section center.
      targetMx = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
      targetMy = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
    };
    const onLeave = () => {
      targetMx = 0;
      targetMy = 0;
    };

    const tick = () => {
      // Ease toward the pointer target — buttery, not twitchy.
      curMx += (targetMx - curMx) * 0.08;
      curMy += (targetMy - curMy) * 0.08;

      section.style.setProperty('--mx', curMx.toFixed(4));
      section.style.setProperty('--my', curMy.toFixed(4));
      section.style.setProperty('--sy', scrollProg.toFixed(4));

      rafId = requestAnimationFrame(tick);
    };

    section.addEventListener('pointermove', onPointer, { passive: true });
    section.addEventListener('pointerleave', onLeave, { passive: true });
    rafId = requestAnimationFrame(tick);

    // ── 3. Scroll parallax — feed scroll progress into the bus so the
    //      DAG layers drift + recede as the hero leaves the viewport. ──
    const scrollTrig = ScrollTrigger.create({
      trigger: section,
      start: 'top top',
      end: 'bottom top',
      scrub: true,
      onUpdate: (self) => {
        scrollProg = self.progress; // consumed by the rAF tick
      },
    });

    // Cleanup for hot-reload / SPA teardowns.
    return () => {
      cancelAnimationFrame(rafId);
      section.removeEventListener('pointermove', onPointer);
      section.removeEventListener('pointerleave', onLeave);
      scrollTrig.kill();
    };
  });
</script>
