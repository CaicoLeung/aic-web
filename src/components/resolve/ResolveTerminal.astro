---
/**
 * ResolveTerminal — animated mockup of the `aic resolve` workflow (ADR-0009).
 *
 * Mirrors hero/Terminal.astro's idiom: the static final state is visible
 * without JS and under `prefers-reduced-motion: reduce`; GSAP reveals the
 * steps in sequence otherwise. `aria-hidden` — decorative reinforcement of
 * the page copy, not primary content. No raster (CONTEXT.md → Visual mockup).
 *
 * The sequence tracks `run_resolve_workflow_impl` in the aic source: detect →
 * per-file resolve → marker retry → review diff → per-file `y/n` → finalize,
 * with one honest v1 skip (binary) surfaced in-mockup.
 */
---

<figure class="terminal" aria-hidden="true">
  <div class="termbar">
    <div class="dots"><i></i><i></i><i></i></div>
    <div class="termtitle"><b>~/</b>projects/your-repo</div>
  </div>

  <div class="termbody" data-resolve-body>
    <div class="row" data-row="cmd">
      <span class="prompt">$</span>
      <span class="cmdin">aic resolve</span>
    </div>
    <div class="row" data-row="detect">
      <span class="warn" aria-hidden="true">⚠</span>
      <span class="out">conflict detected · merge · 2 files</span>
    </div>
    <div class="row" data-row="resolve">
      <span class="spin" aria-hidden="true">⠋</span>
      <span class="out">Resolving src/auth.rs…</span>
    </div>

    <div class="diffcard" data-row="diff">
      <div class="label">reviewed changes · src/auth.rs</div>
      <pre
        class="diff"><span class="del">&lt;&lt;&lt;&lt;&lt;&lt;&lt; HEAD</span>
<span class="del">ours: refresh tokens on idle</span>
<span class="del">=======</span>
<span class="del">theirs: persist via keychain</span>
<span class="del">&gt;&gt;&gt;&gt;&gt;&gt;&gt; feature/login</span>
<span class="add">keep both guards, drop the duplicate</span></pre>
    </div>

    <div class="row" data-row="apply">
      <span class="out">apply src/auth.rs?</span>
      <span class="yn">y</span>
      <span class="ok" aria-hidden="true">✓</span>
      <span class="out">resolved</span>
    </div>
    <div class="row" data-row="skip">
      <span class="dim" aria-hidden="true">•</span>
      <span class="muted">skipped: logo.png (binary — resolve by hand)</span>
    </div>
    <div class="row" data-row="finalize">
      <span class="out">finalize now?</span>
      <span class="yn">y</span>
      <span class="ok" aria-hidden="true">✓</span>
      <span class="out">merge finalized</span>
    </div>
  </div>
</figure>

<style>
  .terminal {
    width: 100%;
    max-width: 600px;
    margin: 0;
    font-family: var(--font-mono);
    background: linear-gradient(180deg, #14161e, #101219);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    box-shadow:
      0 44px 90px -32px rgba(0, 0, 0, 0.75),
      0 0 0 1px rgba(255, 255, 255, 0.02) inset,
      0 1px 0 rgba(255, 255, 255, 0.04) inset;
    overflow: hidden;
    font-size: 0.82rem;
  }
  .termbar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.018);
    border-bottom: 1px solid var(--color-line-soft);
  }
  .dots {
    display: flex;
    gap: 7px;
  }
  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: block;
  }
  .dots i:nth-child(1) {
    background: #f5604d;
  }
  .dots i:nth-child(2) {
    background: #f6bd2f;
  }
  .dots i:nth-child(3) {
    background: #4cce6b;
  }
  .termtitle {
    color: var(--color-ink-dim);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }
  .termtitle b {
    color: var(--color-ink-muted);
    font-weight: 500;
  }
  .termbody {
    padding: 1.25rem 1.4rem 1.5rem;
    line-height: 1.7;
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    white-space: pre;
  }
  .prompt {
    color: var(--color-amber);
  }
  .cmdin {
    color: var(--color-ink);
    font-weight: 600;
  }
  .out {
    color: var(--color-ink-muted);
  }
  .muted {
    color: var(--color-ink-dim);
  }
  .ok {
    color: var(--color-mint);
  }
  .warn {
    color: var(--color-amber-warm);
  }
  .yn {
    color: var(--color-amber);
    font-weight: 600;
  }
  .dim {
    color: var(--color-ink-dim);
  }
  .spin {
    color: var(--color-amber);
    display: inline-block;
  }

  .diffcard {
    margin: 0.85rem 0 1rem;
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-amber);
    border-radius: 8px;
    padding: 0.8rem 1rem;
    background: var(--color-surface);
  }
  .diffcard .label {
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-amber);
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
  .diff {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.55;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .del {
    color: var(--color-ink-dim);
  }
  .add {
    color: var(--color-mint);
  }

  /* Reduced-motion / no-JS default: everything visible. */
  :global([data-resolve-body]) .row,
  :global([data-resolve-body]) .diffcard {
    opacity: 1;
  }
</style>

<script>
  import { gsap, whenMotionOk } from '@/lib/motion';

  whenMotionOk(() => {
    const terms = document.querySelectorAll<HTMLElement>('[data-resolve-body]');

    terms.forEach((term) => {
      const rows = term.querySelectorAll<HTMLElement>('[data-row]');
      const resolveRow = term.querySelector<HTMLElement>('[data-row="resolve"]');
      const spinGlyph = resolveRow?.querySelector<HTMLElement>('.spin');
      if (rows.length === 0 || !resolveRow || !spinGlyph) return;

      gsap.set(rows, { opacity: 0 });
      gsap.set(term.querySelector('[data-row="diff"]'), { y: 8 });

      const spinnerFrames = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏'];
      let frame = 0;

      // Cycles only while the "Resolving" row is on screen; paused otherwise.
      const spinnerCycle = gsap.to(
        {},
        {
          duration: 0.08,
          repeat: -1,
          paused: true,
          onRepeat: () => {
            frame = (frame + 1) % spinnerFrames.length;
            spinGlyph.textContent = spinnerFrames[frame];
          },
        },
      );

      const reveal = (sel: string) =>
        term.querySelector<HTMLElement>(`[data-row="${sel}"]`);

      const tl = gsap.timeline({
        delay: 0.5,
        repeat: -1,
        repeatDelay: 4,
      });

      // 1. Command + detection
      tl.to(reveal('cmd'), { opacity: 1, duration: 0.2 });
      tl.to(reveal('detect'), { opacity: 1, duration: 0.2 }, '+=0.25');

      // 2. "Resolving" spinner cycles, then settles
      tl.call(() => {
        frame = 0;
        spinGlyph.textContent = spinnerFrames[0];
        spinnerCycle.restart();
      });
      tl.to(resolveRow, { opacity: 1, duration: 0.18 });
      tl.to(resolveRow, { opacity: 1, duration: 0.7 }); // hold while spinning
      tl.call(() => spinnerCycle.pause());

      // 3. Review diff card slides up
      tl.to(
        reveal('diff'),
        { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out' },
        '+=0.1',
      );

      // 4. Per-file approval
      tl.to(reveal('apply'), { opacity: 1, duration: 0.2 }, '+=0.2');
      // 5. Honest v1 skip
      tl.to(reveal('skip'), { opacity: 1, duration: 0.2 }, '+=0.25');
      // 6. Finalize
      tl.to(reveal('finalize'), { opacity: 1, duration: 0.2 }, '+=0.25');
    });
  });
</script>
