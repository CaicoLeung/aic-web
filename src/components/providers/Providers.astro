---
/**
 * Providers & privacy — provider list (live from source repo via
 * loadAicFacts) + the "your key · your model · no middleman" positioning.
 */
import { GITHUB_URL } from '@/config/site';
import type { ProviderInfo } from '@/config/site';
import { localeFromUrl } from '@/i18n/config';
import { useLocalizer } from '@/i18n/t';

interface Props {
  readonly providers: readonly ProviderInfo[];
}
const { providers } = Astro.props;
const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
---

<section id="providers" class="section providers">
  <div class="container">
    <p class="eyebrow">
      <span class="line" aria-hidden="true"></span>{t('providers.eyebrow')}
    </p>
    <h2>{t('providers.h2')}</h2>
    <p class="lede">
      {t('providers.lede')}
    </p>

    <ul class="provider-list" aria-label="Supported LLM providers">
      {providers.map((p) => <li class="provider-chip">{p.name}</li>)}
    </ul>

    <dl class="default-models" aria-label="Default model per provider">
      {
        providers.map((p) => (
          <div class="model-row">
            <dt>{p.name}</dt>
            <dd>
              {p.defaultModel ?? <span class="muted">{t('providers.yourModel')}</span>}
            </dd>
          </div>
        ))
      }
    </dl>

    <p class="aside">
      {t('providers.aside')}
    </p>
    <p class="aside" set:html={t('providers.profilesHint')} />
    <a
      class="link"
      href={`${GITHUB_URL}/blob/main/src/llm.rs`}
      target="_blank"
      rel="noopener noreferrer"
    >
      {t('providers.link')}
    </a>
  </div>
</section>

<style>
  .providers {
    padding: clamp(3rem, 1rem + 6vw, 6rem) 0;
    position: relative;
    z-index: 2;
  }
  h2 {
    font-size: var(--text-h2);
    line-height: 1.05;
    margin: 0.75rem 0 0;
  }
  .lede {
    color: var(--color-ink-muted);
    line-height: 1.65;
    margin-top: 1rem;
    max-width: 40rem;
    font-size: var(--text-lede);
  }
  .provider-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: 2rem 0 1rem;
  }
  .provider-chip {
    font-family: var(--font-mono);
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: rgba(21, 23, 31, 0.55);
    color: var(--color-ink);
    font-size: 0.85rem;
    font-weight: 500;
    transition:
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }
  .provider-chip:hover {
    border-color: var(--color-amber);
    color: var(--color-amber);
  }
  .default-models {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0.35rem 1.5rem;
    margin: 1.25rem 0 1.5rem;
    border-top: 1px solid var(--color-line);
    padding-top: 1.25rem;
  }
  .model-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .model-row dt {
    font-family: var(--font-mono);
    color: var(--color-ink-muted);
    font-size: 0.8rem;
    min-width: 7rem;
  }
  .model-row dd {
    font-family: var(--font-mono);
    color: var(--color-ink);
    font-size: 0.8rem;
    margin: 0;
    word-break: break-all;
  }
  .model-row .muted {
    color: var(--color-ink-muted);
  }
  .aside {
    color: var(--color-ink-muted);
    font-size: 0.9375rem;
    margin: 0.5rem 0 1.5rem;
  }
  .link {
    color: var(--color-amber);
    text-decoration: none;
    font-size: 0.88rem;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) ease;
  }
  .link:hover {
    border-bottom-color: var(--color-amber);
  }
</style>
