---
/**
 * Changelog — vertical timeline of releases. One node per release;
 * left rail + dot, body with version/date/per-node GitHub link and the
 * Keep-a-Changelog category subheads rendered verbatim.
 *
 * Build-time only: entries come pre-parsed from `loadChangelog()`.
 */
import type { ChangelogEntry } from '@/data/changelog';
import { localeFromUrl } from '@/i18n/config';
import { LOCALE_HREFLANG } from '@/i18n/config';
import { useLocalizer } from '@/i18n/t';

interface Props {
  readonly entries: readonly ChangelogEntry[];
}
const { entries } = Astro.props;
const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
// Date format follows the page locale (ADR-0010) — zh → zh-CN, etc.
const fmtDate = new Intl.DateTimeFormat(LOCALE_HREFLANG[locale], {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<ol class="timeline">
  {
    entries.map((entry, i) => (
      <li class="node" id={entry.version}>
        <div class="rail" aria-hidden="true">
          <span class="dot" />
        </div>
        <div class="body">
          <div class="node-head">
            <h2 class="version">v{entry.version}</h2>
            {i === 0 && (
              <span class="latest-badge">{t('changelog.timeline.latest')}</span>
            )}
            <time class="date" datetime={entry.date}>
              {fmtDate.format(new Date(entry.date))}
            </time>
            <a
              class="release-link"
              href={entry.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {t('changelog.timeline.githubRelease')}
              <span aria-hidden="true"> ↗</span>
            </a>
          </div>

          {entry.sections.length === 0 ? (
            <p class="no-notes">{t('changelog.timeline.noNotes')}</p>
          ) : (
            entry.sections.map((section) => (
              <section class="change-section">
                <h3>{section.kind}</h3>
                <ul>
                  {section.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>
            ))
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
  }
  .node {
    display: grid;
    grid-template-columns: 28px 1fr;
    column-gap: 1rem;
    padding-bottom: 2.5rem;
    position: relative;
  }
  .node:last-child {
    padding-bottom: 0;
  }
  /* Continuous vertical line through the rail column. Spans the full
     node height (including its padding) so adjacent nodes connect. */
  .node::before {
    content: '';
    position: absolute;
    left: 14px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-line);
    transform: translateX(-0.5px);
  }
  /* Last node: stop the line at the dot's vertical center. */
  .node:last-child::before {
    bottom: auto;
    height: 18px;
  }
  .rail {
    position: relative;
    z-index: 1;
  }
  .dot {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-amber);
    margin: 6px auto 0;
    box-shadow: 0 0 0 4px var(--color-base);
  }
  .body {
    min-width: 0;
  }
  .node-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 0.85rem;
  }
  .version {
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .latest-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #1a1408;
    background: var(--color-amber);
    border-radius: 999px;
    padding: 0.18rem 0.6rem;
    font-weight: 700;
    align-self: center;
  }
  .date {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .release-link {
    margin-left: auto;
    color: var(--color-amber);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) ease;
  }
  .release-link:hover {
    border-bottom-color: var(--color-amber);
  }

  .change-section {
    margin-top: 1rem;
  }
  .change-section h3 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin: 0 0 0.4rem;
    font-weight: 600;
  }
  .change-section ul {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .change-section li {
    color: var(--color-ink);
    line-height: 1.6;
    font-size: 0.95rem;
  }
  .change-section li::marker {
    color: var(--color-ink-dim);
  }
  .no-notes {
    color: var(--color-ink-dim);
    font-style: italic;
    margin: 0.85rem 0 0;
    font-size: 0.9rem;
  }

  @media (max-width: 480px) {
    .node {
      grid-template-columns: 20px 1fr;
      column-gap: 0.75rem;
      padding-bottom: 2rem;
    }
    .node::before {
      left: 10px;
    }
    .version {
      font-size: 1.2rem;
    }
    .release-link {
      margin-left: 0;
    }
  }
</style>
