---
/**
 * Footer — final CTA + repo credit.
 */
import { GITHUB_URL, PRIMARY_INSTALL_COMMAND } from '@/config/site';
import { localizedHref, localeFromUrl } from '@/i18n/config';
import { useLocalizer } from '@/i18n/t';
import CopyButton from '@/components/ui/CopyButton.astro';

const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
const resolveBase = localizedHref(locale, 'resolve');
const compareBase = localizedHref(locale, 'vs/aicommits');
const roundupBase = localizedHref(locale, 'best-ai-commit-tools');
const changelogBase = localizedHref(locale, 'changelog');
---

<footer class="footer">
  <div class="footer-inner container">
    <div class="footer-cta">
      <p class="eyebrow">
        <span class="line" aria-hidden="true"></span>{t('footer.eyebrow')}
      </p>
      <h2>{t('footer.h2')}</h2>
      <div class="footer-actions">
        <CopyButton
          text={PRIMARY_INSTALL_COMMAND}
          label="brew tap CaicoLeung/aic && brew install aic"
          variant="primary"
        />
        <a
          class="footer-link"
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t('footer.star')}
        </a>
      </div>
    </div>

    <div class="footer-meta">
      <a class="repo" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
        {GITHUB_URL.replace('https://', '')}
      </a>
      <nav class="footer-links" aria-label="Explore">
        <a href={resolveBase}>
          <svg
            class="flink-icon"
            viewBox="0 0 24 24"
            width="15"
            height="15"
            aria-hidden="true"
          >
            <circle
              cx="7"
              cy="7"
              r="2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"></circle>
            <circle
              cx="7"
              cy="17"
              r="2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"></circle>
            <circle
              cx="17"
              cy="17"
              r="2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"></circle>
            <path
              d="M7 9v6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path>
            <path
              d="M17 15c0-3.5-2.5-5-5-5H7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span>{t('footer.nav.resolve')}</span>
        </a>
        <a href={roundupBase}>
          <svg
            class="flink-icon"
            viewBox="0 0 24 24"
            width="15"
            height="15"
            aria-hidden="true"
          >
            <path
              d="M8 6h12M8 12h12M8 18h12"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path>
            <circle cx="4" cy="6" r="1" fill="currentColor"></circle>
            <circle cx="4" cy="12" r="1" fill="currentColor"></circle>
            <circle cx="4" cy="18" r="1" fill="currentColor"></circle>
          </svg>
          <span>{t('footer.nav.roundup')}</span>
        </a>
        <a href={compareBase}>
          <svg
            class="flink-icon"
            viewBox="0 0 24 24"
            width="15"
            height="15"
            aria-hidden="true"
          >
            <path
              d="m7 4-4 4 4 4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M3 8h14"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path>
            <path
              d="m17 20 4-4-4-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M21 16H7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path>
          </svg>
          <span>{t('footer.nav.compare')}</span>
        </a>
        <a href={changelogBase}>
          <svg
            class="flink-icon"
            viewBox="0 0 24 24"
            width="15"
            height="15"
            aria-hidden="true"
          >
            <circle
              cx="12"
              cy="12"
              r="8"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"></circle>
            <path
              d="M12 8v4l3 2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span>{t('footer.nav.changelog')}</span>
        </a>
      </nav>
      <p>{t('footer.meta')}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--color-line-soft);
    padding: clamp(3rem, 1rem + 5vw, 5rem) 0 2rem;
    background: var(--color-base-deep);
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  h2 {
    font-size: var(--text-h2);
    line-height: 1.05;
    margin: 0.75rem 0 1.5rem;
  }
  .footer-actions {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .footer-link {
    color: var(--color-ink);
    text-decoration: none;
    padding: 0.55rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    transition:
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }
  .footer-link:hover {
    border-color: var(--color-amber);
    color: var(--color-amber);
  }
  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line-soft);
    color: var(--color-ink-muted);
    font-size: 0.85rem;
  }
  .repo {
    color: var(--color-ink-muted);
    text-decoration: none;
    width: fit-content;
  }
  .repo:hover {
    color: var(--color-amber);
  }
  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 0.65rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }
  .footer-links a:hover {
    color: var(--color-amber);
  }
  .flink-icon {
    color: var(--color-ink-dim);
    flex-shrink: 0;
    transition: color var(--duration-fast) ease;
  }
  .footer-links a:hover .flink-icon {
    color: var(--color-amber);
  }
  @media (min-width: 768px) {
    .footer-links {
      display: inline-flex;
      gap: 0.85rem;
    }
  }
</style>
