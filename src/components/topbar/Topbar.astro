---
/**
 * Sticky topbar — brand left, anchor nav center, version + GitHub + locale
 * switcher right. Background blur kicks in after the hero scrolls past
 * (Tier 2 motion).
 *
 * i18n (ADR-0010): locale is read from the URL; all visible strings come
 * from the message module via `t()`. This component is the reference
 * wiring pattern for every other section.
 */
import { GITHUB_URL } from '@/config/site';
import { localizedHref, localeFromUrl } from '@/i18n/config';
import { useLocalizer } from '@/i18n/t';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  readonly version: string;
}
const { version } = Astro.props;
const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
const changelog = localizedHref(locale, 'changelog');
const versionTitle = t('topbar.versionTitle', { version });
---

<header class="topbar" data-topbar>
  <a class="brand" href="#top" aria-label="aic — home">
    <span class="mark" aria-hidden="true">
      <svg class="mark-svg" viewBox="0 0 24 24" width="22" height="22" focusable="false">
        <path d="M10,5 Q10,13 18,13 Q10,13 10,21 Q10,13 2,13 Q10,13 10,5 Z" fill="#1a1408"
        ></path>
        <path d="M18,2 Q18,6 22,6 Q18,6 18,10 Q18,6 14,6 Q18,6 18,2 Z" fill="#1a1408"
        ></path>
      </svg>
    </span>
    <span class="brand-text">
      <span class="brand-name">aic</span>
      <span class="brand-tag">{t('topbar.brandTag')}</span>
    </span>
  </a>

  <nav class="nav" aria-label="Sections">
    <a href="#how">{t('topbar.nav.how')}</a>
    <a href="#batching">{t('topbar.nav.batching')}</a>
    <a href="#resolve">{t('topbar.nav.resolve')}</a>
    <a href="#agents">{t('topbar.nav.agents')}</a>
    <a href="#providers">{t('topbar.nav.providers')}</a>
    <a href="#install">{t('topbar.nav.install')}</a>
  </nav>
  <div class="meta">
    <a class="version" href={changelog} title={versionTitle}>
      <span class="version-dot" aria-hidden="true"></span>
      v{version}
    </a>
    <a
      class="github"
      href={GITHUB_URL}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={t('topbar.github')}
      title={t('topbar.github')}
    >
      <svg
        class="github-icon"
        viewBox="0 0 16 16"
        width="20"
        height="20"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
        ></path>
      </svg>
    </a>
    <LanguageSwitcher />
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem clamp(1rem, 0.4rem + 2vw, 3rem);
    background: color-mix(in oklch, var(--color-base-deep) 70%, transparent);
    border-bottom: 1px solid transparent;
    backdrop-filter: none;
    transition:
      border-color var(--duration-normal) var(--ease-out-expo),
      background var(--duration-normal) var(--ease-out-expo),
      transform var(--duration-normal) var(--ease-out-expo);
  }
  .topbar[data-blur='true'] {
    border-bottom-color: var(--color-line-soft);
    backdrop-filter: blur(14px) saturate(140%);
    background: color-mix(in oklch, var(--color-base-deep) 80%, transparent);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    color: inherit;
  }
  .mark {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: linear-gradient(145deg, var(--color-amber), var(--color-amber-warm));
    display: grid;
    place-items: center;
    box-shadow:
      0 10px 28px -8px rgba(243, 179, 64, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }
  .mark-svg {
    display: block;
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }
  .brand:hover .mark-svg {
    transform: rotate(12deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .mark-svg,
    .brand:hover .mark-svg {
      transition: none;
      transform: none;
    }
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.06rem;
    letter-spacing: -0.01em;
  }
  .brand-tag {
    font-size: 0.72rem;
    color: var(--color-ink-muted);
  }
  .nav,
  .meta {
    font-family: var(--font-mono);
  }
  .nav {
    display: none;
    gap: 1.75rem;
    font-size: 0.82rem;
    color: var(--color-ink-muted);
  }
  .nav a {
    text-decoration: none;
    color: inherit;
    transition: color var(--duration-fast) ease;
  }
  .nav a:hover {
    color: var(--color-amber);
  }
  .meta {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.78rem;
  }
  .version {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }
  .version:hover {
    color: var(--color-ink);
    border-color: var(--color-amber);
  }
  .version-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-mint);
    box-shadow: 0 0 0 3px var(--color-mint-soft);
  }
  .github {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--color-ink);
    text-decoration: none;
    border-radius: 8px;
    transition:
      color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }
  .github:hover {
    color: var(--color-amber);
    background: var(--color-amber-soft);
  }
  .github-icon {
    display: block;
  }
  @media (min-width: 768px) {
    .nav {
      display: inline-flex;
    }
  }
  /* Mobile re-flow: brand + utilities share row 1, the section-nav drops
     to a full-width centered row beneath (mirrors ContentHeader). Every
     anchor stays one-tap reachable — no disclosure, no JS. */
  @media (max-width: 767px) {
    .topbar {
      flex-wrap: wrap;
      gap: 0.7rem;
      padding-block: 0.7rem;
    }
    .nav {
      display: flex;
      order: 3;
      width: 100%;
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: safe center;
      gap: 0.5rem;
      font-size: 0.76rem;
      scrollbar-width: none;
      overflow-y: hidden;
    }
    .topbar.is-hidden {
      transform: translateY(-100%);
    }

    .brand {
      order: 1;
    }
    .meta {
      order: 2;
    }
    .nav::-webkit-scrollbar {
      display: none;
    }
    .brand-tag {
      display: none;
    }
  }
  @media (max-width: 359px) {
    .topbar {
      padding-inline: 0.6rem;
    }
  }
  /* Tablet widths: tighten the nav gap so all six anchors fit alongside
     the brand and meta. */
  @media (min-width: 768px) and (max-width: 950px) {
    .nav {
      gap: 1rem;
    }
  }
  /* Phones: version pill is pure chrome — changelog stays reachable via
     the footer. */
  @media (max-width: 480px) {
    .version {
      display: none;
    }
  }
</style>

<script>
  const topbar = document.querySelector('[data-topbar]');
  if (topbar) {
    let lastScroll = 0;
    const mqMobile = window.matchMedia('(max-width: 767px)');

    const onScroll = () => {
      const y = window.scrollY;
      // Mobile: slide entire topbar away on scroll-down, reveal on scroll-up.
      // Uses transform (compositor-only) — never touches document height,
      // so no scroll-position feedback loop.
      if (mqMobile.matches) {
        if (y > lastScroll + 8 && y > 0) {
          topbar.classList.add('is-hidden');
        } else if (y < lastScroll - 4 || y <= 0) {
          topbar.classList.remove('is-hidden');
        }
      } else {
        topbar.classList.remove('is-hidden');
      }
      lastScroll = y;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Backdrop blur kicks in once the hero (first section in <main>) has
    // scrolled completely out of view. IntersectionObserver — no scroll
    // handler, fires only on the enter/leave transition.
    const hero = document.querySelector('main section');
    if (hero) {
      new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) topbar.removeAttribute('data-blur');
          else topbar.setAttribute('data-blur', 'true');
        },
        { threshold: 0 },
      ).observe(hero);
    }
  }
</script>
