---
/**
 * Language switcher (ADR-0010 / Q8).
 *
 * Native-language labels (`English · 中文 · 日本語 · 한국어`) per Q8. Selecting
 * a locale navigates to the localized equivalent of the current path —
 * it does not persist a preference, so each page honors its own URL.
 * ASCII slugs (Q9=A) mean only the locale prefix changes.
 */
import { LOCALES, LOCALE_LABELS, localeFromUrl } from '@/i18n/config';
import { baseHref } from '@/lib/href';
import { useLocalizer } from '@/i18n/t';
import { sharedSlug } from '@/i18n/hreflang';

const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
const base = baseHref(import.meta.env.BASE_URL);

// Locale-invariant slug shared across all localized paths (ADR-0010 / Q9=A).
const slug = sharedSlug(Astro.url.pathname, import.meta.env.BASE_URL);
---

<div class="lang">
  <label for="lang-switch" class="sr-only">{t('topbar.switcher.label')}</label>
  <select
    id="lang-switch"
    class="lang-select"
    data-lang-switch
    data-base={base}
    data-slug={slug}
    aria-label={t('topbar.switcher.label')}
  >
    {LOCALES.map((l) => (
      <option value={l} selected={l === locale}>{LOCALE_LABELS[l]}</option>
    ))}
  </select>
</div>

<script is:inline>
  (function () {
    var sel = document.querySelector('[data-lang-switch]');
    if (!sel) return;
    var base = sel.getAttribute('data-base') || '/';
    var slug = sel.getAttribute('data-slug') || '';
    sel.addEventListener('change', function () {
      var pref = sel.value;
      var prefix = pref === 'en' ? '' : pref + '/';
      var tail = slug ? slug + '/' : '';
      location.href = base + prefix + tail;
    });
  })();
</script>

<style>
  .lang-select {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-ink-muted);
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.3rem 0.6rem;
    cursor: pointer;
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }
  .lang-select:hover {
    color: var(--color-ink);
    border-color: var(--color-amber);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
