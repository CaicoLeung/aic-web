---
/**
 * /[locale]/deepseek/ — localized capability page (ADR-0010).
 */
import { isLocalePrefix, LOCALE_PREFIXES } from '@/i18n/config';
import DeepseekPage from '@/components/content/DeepseekPage.astro';

export function getStaticPaths() {
  return LOCALE_PREFIXES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
if (!isLocalePrefix(locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
---

<DeepseekPage />
