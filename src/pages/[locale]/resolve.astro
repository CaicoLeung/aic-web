---
/**
 * /[locale]/resolve/ — localized resolve page (ADR-0010).
 *
 * Renders the same `ResolvePage` component as the English route; Base
 * self-determines locale from the URL. Stubbed keys fall back to the EN
 * source (soft parity, Q7=B).
 */
import { isLocalePrefix, LOCALE_PREFIXES } from '@/i18n/config';
import ResolvePage from '@/components/content/ResolvePage.astro';

export function getStaticPaths() {
  return LOCALE_PREFIXES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
// getStaticPaths enumerates only valid prefixes; this is belt-and-suspenders
// — shared guard: unknown segments 404 instead of rendering a fake locale.
if (!isLocalePrefix(locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
---

<ResolvePage />
