---
/**
 * /[locale]/vs/[id]/ — localized head-to-head comparison routes (ADR-0010).
 *
 * Enumerates every locale × rival so each `/{locale}/vs/{id}` page is
 * pre-rendered; the layout/components resolve locale from the URL. Body
 * lives in `VsCompetitorPage`.
 */
import { isLocalePrefix, LOCALE_PREFIXES } from '@/i18n/config';
import VsCompetitorPage from '@/components/content/VsCompetitorPage.astro';
import { COMPARISONS } from '@/config/competitors';

export function getStaticPaths() {
  const rivalIds = Object.keys(COMPARISONS);
  return LOCALE_PREFIXES.flatMap((locale) =>
    rivalIds.map((id) => ({
      params: { locale, id },
      props: { comparison: COMPARISONS[id] },
    })),
  );
}

const { locale } = Astro.params;
if (!isLocalePrefix(locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const { comparison } = Astro.props;
---

<VsCompetitorPage comparison={comparison} />
