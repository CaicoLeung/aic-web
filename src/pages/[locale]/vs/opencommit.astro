---
/**
 * /[locale]/vs/opencommit/ — localized comparison page (ADR-0010).
 */
import { isLocalePrefix, LOCALE_PREFIXES } from '@/i18n/config';
import VsCompetitorPage from '@/components/content/VsCompetitorPage.astro';
import { OPENCOMMIT_COMPARISON } from '@/config/competitors';

export function getStaticPaths() {
  return LOCALE_PREFIXES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
if (!isLocalePrefix(locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
---

<VsCompetitorPage id="opencommit" comparison={OPENCOMMIT_COMPARISON} />
