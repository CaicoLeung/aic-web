---
/**
 * /[locale]/vs/aicommits/ — localized comparison page (ADR-0010).
 * Renders the same `VsCompetitorPage` as the English route; Base
 * self-determines locale. Stubbed keys fall back to the EN source
 * (soft parity, Q7=B).
 */
import { isLocalePrefix, LOCALE_PREFIXES } from '@/i18n/config';
import VsCompetitorPage from '@/components/content/VsCompetitorPage.astro';
import { AICOMMITS_COMPARISON } from '@/config/competitors';

export function getStaticPaths() {
  return LOCALE_PREFIXES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
// getStaticPaths enumerates only valid prefixes; this is belt-and-suspenders
// — shared guard: unknown segments 404 instead of rendering a fake locale.
if (!isLocalePrefix(locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
---

<VsCompetitorPage
  id="aicommits"
  comparison={AICOMMITS_COMPARISON}
  datePublished="2026-07-08"
  dateModified="2026-07-31"
/>
