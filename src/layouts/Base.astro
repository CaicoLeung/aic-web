---
/**
 * Base layout — HTML shell, head, font preloads, OG metadata.
 * Spiritual-adaptation (ADR-0002): palette + grain + glows come from
 * the design tokens in global.css, not hardcoded here.
 *
 * i18n (ADR-0010): locale is self-determined from the URL — no prop
 * threading. `<html lang>`, title/description, hreflang alternates, and
 * og:locale all derive from it. Navigation chrome uses locale-aware
 * hrefs, so visitors stay in their locale across page transitions.
 */
import '@/styles/global.css';
import { LOCALE_HREFLANG, localeFromUrl } from '@/i18n/config';
import { useLocalizer } from '@/i18n/t';
import { buildHreflangAlternates } from '@/i18n/hreflang';

interface Props {
  readonly version: string;
  readonly title?: string;
  readonly description?: string;
  /** Per-page structured data. Omit on the home page to keep the default
   *  SoftwareApplication schema. Pass an Article-shaped object on content
   *  pages so a comparison page isn't mistagged as the app itself. */
  readonly schema?: Record<string, unknown> | readonly Record<string, unknown>[];
}

const { version, title, description, schema } = Astro.props;

// Locale self-determined from the URL (ADR-0010).
const locale = localeFromUrl(Astro.url.pathname);
const t = useLocalizer(locale);
const resolvedTitle = title ?? t('meta.title');
const resolvedDescription = description ?? t('meta.description');

// Home keeps SoftwareApplication; content pages pass their own schema.
const jsonLd = schema ?? {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'aic',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  softwareVersion: `v${version}`,
  description: resolvedDescription,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const site = Astro.site?.toString() ?? 'https://caicoleung.github.io';
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL('/aic-web/og.png', site).toString();
const themeColor = '#0e0f14';
const ogLocale = LOCALE_HREFLANG[locale].replace('-', '_').replace(/^en$/, 'en_US');
const hreflangAlternates = buildHreflangAlternates(Astro.url.pathname, site);
// Locale-aware CJK system font stack (supersedes ADR-0012's Noto webfont —
// see docs/adr/0014-cjk-system-fonts-supersede-0012.md). Zero webfont cost:
// each locale resolves to its native system CJK families. Undefined on `en`
// → the type stacks fall back to a zh-leaning default that covers the rare
// CJK glyph in EN copy without loading any font.
const cjkStack =
  locale === 'zh'
    ? "'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei'"
    : locale === 'ja'
      ? "'Hiragino Sans', 'Yu Gothic', 'Noto Sans CJK JP'"
      : locale === 'ko'
        ? "'Apple SD Gothic Neo', 'Malgun Gothic', 'Nanum Gothic'"
        : undefined;
---

<!doctype html>
<html
  lang={LOCALE_HREFLANG[locale]}
  style={cjkStack ? `--font-cjk:${cjkStack}` : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <meta name="theme-color" content={themeColor} />
    <meta
      name="google-site-verification"
      content="Ih8LNd1hTZy3EI4Hx-_wx21ruZj5gR6eosSk1l47b5A"
    />
    <meta
      name="google-site-verification"
      content="H26c_jjsBWfu5DJuCf3fURNdRzHvNydAXttVaOPRsmM"
    />
    <link rel="canonical" href={canonical} />

    {/* hreflang alternates + x-default → en (ADR-0010) */}
    {
      hreflangAlternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }

    {/* icons */}
    <link rel="icon" href="/aic-web/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/aic-web/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/aic-web/manifest.webmanifest" />

    {/* apple web app */}
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="aic" />

    {/* fonts — preload only regular weight (Q12 hybrid) */}
    <link
      rel="preload"
      href="/aic-web/fonts/JetBrainsMono-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* open graph / twitter */}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={ogImage} />

    {/* structured data — SoftwareApplication (home) or per-page schema */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    {/* PWA: register service worker (progressive enhancement — fails silently) */}
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/aic-web/sw.js').catch(() => {});
        });
      }
    </script>

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="relative z-2 contents">
      <slot />
    </div>
  </body>
</html>
