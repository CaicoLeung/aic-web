{
  "name": "aic-web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Marketing site for aic — AI-powered git commits. Built with Astro + Tailwind v4 + GSAP.",
  "scripts": {
    "dev": "astro dev",
    "build": "tsc --noEmit && astro build && (node --import tsx scripts/i18n-stub-report.ts || true)",
    "preview": "astro preview",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "lint": "eslint . --ext .ts,.astro",
    "axe": "axe-preview",
    "i18n:report": "node --import tsx scripts/i18n-stub-report.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^6.4.8",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "axe-core": "^4.14.0",
    "husky": "^9.1.7",
    "lint-staged": "~17.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,js,mjs,astro,json,md,css}": "prettier --write",
    "*": "sh -c 'pnpm check && pnpm test'"
  }
}
