# aic-web server config (ADR-0021) — deploy to cPanel docroot alongside /aic/
# Hashed build assets are immutable: content-hashed filenames change on rebuild.
<IfModule mod_headers.c>
  <FilesMatch "\\.(woff2|js|css|png|svg|webmanifest)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML revalidates (edge TTL lives in the Cloudflare Cache Rule instead)
  <FilesMatch "\\.html?$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
